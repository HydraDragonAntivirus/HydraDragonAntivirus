//
// Local policy definition for PatternsMatching
//
{
	"version": 2,
	"name": "ptmLocal",
	"group": "patternsMatching",
	"dependencies": [ "common" ],

	"constants": {
		"basket": {
			"fileReadWrite": "FILE_COPY_READ_WRITE",
			"fileWriteRead": "FILE_COPY_WRITE_READ"
		},
		"ransomEventBaseType": {
			"MLE_RANSOM_SHADOW_COPY_DELETE": 1000009,
			"MLE_PSW_STEALER": 1000011
		},
		"pswBasket": {
			"pswCredRead": "PSW_CRED_READ",
			"pswReadFiles": "PSW_READ_FILES",
			"pswWriteAfterRead": "PSW_WRITE_AFTER_READ"
		},
		// Credential / browser data paths (imatch is case-insensitive)
		"pswCredPaths": [
			"*\\Google\\Chrome\\User Data*",
			"*\\Microsoft\\Edge\\User Data*",
			"*\\BraveSoftware\\Brave-Browser\\User Data*",
			"*\\Opera Software\\Opera Stable*",
			"*\\Opera Software\\Opera GX Stable*",
			"*\\Discord\\Local Storage*",
			"*\\Discord\\leveldb*",
			"*Electrum\\wallets*",
			"*Bitcoin\\wallets*",
			"*Ethereum\\keystore*",
			"*Cookies*",
			"*Login Data*",
			"*Web Data*",
			"*Local State*"
		],
		// imatch (case-insensitive wildcard) patterns for shadow-copy wiping
		"ransomShadowDeleteCmdLines": [
			"*vssadmin*delete shadows*",
			"*wmic*shadowcopy delete*",
			"*wmic*shadowcopy*delete*",
			"*wbadmin*delete catalog*"
		]
	},

	"variables": {
		"copyFileKey": [ "@event.process.id", "@event.file.rawHash" ],
		"ransomPathKey": [ "@event.process.id", "@event.file.uniquePath" ]
	},

	"patterns": {

		//
		// Pattern for copy-file READ-WRITE scenario
		//
		"FILE_COPY_READ_WRITE": [

			// Detect full read and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey"
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@event.file"
							},
							{
								"name": "source",
								"value": "@context.file"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							}
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileReadWrite",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_READ_WRITE

		//
		// Pattern for copy-file WRITE-READ scenario
		//
		"FILE_COPY_WRITE_READ": [

			// Detect full write and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"maxCopyCount": 100,
						"data": {
							"file": "@event.file",
							"time": "@event.time",
							"tickTime": "@event.tickTime"
						}
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"delete": true
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@context.file"
							},
							{
								"name": "source",
								"value": "@event.file"
							},
							{
								"name": "time",
								"value": "@context.time"
							},
							{
								"name": "tickTime",
								"value": "@context.tickTime"
							}
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileWriteRead",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_WRITE_READ

		//
		//
		// PSW Stealer: credential file full-read + outbound network connect.
		// A process that reads credential databases and then connects out
		// is exfiltrating stolen data. No destructive op needed.
		//
		"PSW_CREDENTIAL_ACCESS": [

			// 1) Full sequential read of a credential/browser data file:
			//    only tracks reads matching credential path patterns
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "@const.pswCredPaths",
						"args": [ "@event.file.uniquePath" ]
					},
					"saveContext": {
						"basket": "@const.basket.pswCredRead",
						"key": "@event.process.id",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 2) Outbound network connect from a process that previously
			//    read credential files = exfiltration attempt
			{
				"eventType": "LLE_NETWORK_CONNECT_OUT",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.pswCredRead",
						"key": "@event.process.id"
					},
					"createEvent": {
						"eventType": "MLE_PSW_STEALER",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" }
						]
					}
				}
			},

			// Cleanup on process exit
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.pswCredRead",
						"group": "@event.process.id"
					}
				}
			}
		] // PSW_CREDENTIAL_ACCESS

,
		// Pattern for shadow-copy deletion: vssadmin/wmic/wbadmin wiping
		// volume shadow copies is a near-zero-FP ransomware footprint.
		//
		"RANSOM_SHADOW_COPY_DELETE": [
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "@const.ransomShadowDeleteCmdLines",
						"args": [ "@event.process.cmdLine" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_SHADOW_COPY_DELETE",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomEventBaseType.MLE_RANSOM_SHADOW_COPY_DELETE" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" }
						]
					}
				}
			}
		] // RANSOM_SHADOW_COPY_DELETE
	}
}
