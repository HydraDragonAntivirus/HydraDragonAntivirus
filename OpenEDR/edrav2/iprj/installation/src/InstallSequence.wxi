<?xml version="1.0" encoding="UTF-8"?>
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- If DISABLE=1, it means token is absent and edr is being installed in "local mode".-->
  <!--Enroll-stage shoud be skipped if DISABLE=1-->
  <Property Id="DISABLE" Value="0" />
  
  <!-- If UPDATE=1, Install should skip Enroll-stage -->
  <Property Id="UPDATE" Value="0" />
	
  <InstallExecuteSequence>
		<Custom Action="SetReinstallMode" Before="OfferRepairing" Condition="Installed AND REINSTALL" />
		<Custom Action="OfferRepairing" Before="OnStartAdminInstallation" Condition="Installed AND NOT REMOVE AND NOT REINSTALL" />
		<Custom Action="OnStartAdminInstallation" Before="FindRelatedProducts" Condition="NOT Installed AND NOT REMOVE" />
		<Custom Action="SetActualInstallDir" Before="InstallInitialize" />
			
		<!-- Enable test signing for unsigned driver support -->
		<Custom Action="EnableTestSigning" After="InstallFiles" Condition="NOT Installed AND NOT REMOVE" />

		<!-- Test signing only takes effect after a reboot -->
		<ScheduleReboot After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
		
		<Custom Action="SetOnStartInstallationData" Before="OnStartInstallation" />
		<Custom Action="OnStartInstallation" After="OnErrorInstallation" Condition="(NOT Installed AND NOT REMOVE) OR REINSTALL" />
		<Custom Action="SetOnErrorInstallationData" Before="OnErrorInstallation" />
		<Custom Action="OnErrorInstallation" After="InstallInitialize" Condition="NOT REINSTALL" />
		<!--only on install-->
		<Custom Action="GetSvcInstallCmdLine" Before="InstallValidate" Condition="NOT Installed AND NOT REMOVE" />
			
		<Custom Action="RemoveExistingComodoProducts" After="InstallFiles" Condition="(NOT Installed AND NOT REMOVE) OR REINSTALL" />
		<Custom Action="SetRemoveExistingComodoProductsData" Before="RemoveExistingComodoProducts" Condition="(NOT Installed AND NOT REMOVE) OR REINSTALL" />
			
		<Custom Action="SetRollbackInstalledEdrServiceData" Before="RollbackInstalledEdrService" Condition="(NOT Installed) AND (NOT REMOVE)" />
		<Custom Action="RollbackInstalledEdrService" Before="StartEdrService" Condition="(NOT Installed) AND (NOT REMOVE)" />
			
		<Custom Action="SetInstallEdrServiceData" Before="InstallEdrService" Condition="(NOT Installed OR REINSTALL) AND (NOT REMOVE)" />
		<Custom Action="InstallEdrService" After="RollbackInstalledEdrService" Condition="(NOT Installed OR REINSTALL) AND (NOT REMOVE)" />

		<Custom Action="SetEnrollEdrServiceData" Before="EnrollEdrService" Condition="(NOT Installed OR REINSTALL) AND (NOT REMOVE) AND NOT (DISABLE=1) AND NOT (UPDATE=1)" />
		<Custom Action="EnrollEdrService" After="InstallEdrService" Condition="(NOT Installed OR REINSTALL) AND (NOT REMOVE) AND NOT (DISABLE=1) AND NOT (UPDATE=1)" />

		<Custom Action="SetStartEdrServiceData" Before="StartEdrService" Condition="(NOT Installed OR REINSTALL) AND (NOT REMOVE) AND NOT (DISABLE=1)" />
		<Custom Action="StartEdrService" Before="OnSuccessInstallation" Condition="(NOT Installed OR REINSTALL) AND (NOT REMOVE) AND NOT (DISABLE=1)" />

		<Custom Action="SetOnSuccessInstallationData" Before="OnSuccessInstallation" Condition="NOT INTERRUPT_AND_RESTART" />
		<Custom Action="OnSuccessInstallation" Before="InstallFinalize" Condition="NOT INTERRUPT_AND_RESTART" />

		<!--restarting of the service is a workaround to get the proper policies during the update installation mode-->
		<Custom Action="SetRestartEdrServiceData" Before="RestartEdrService" Condition="(UPDATE=1) AND (NOT REMOVE)" />
		<Custom Action="RestartEdrService" After="StartEdrService" Condition="(UPDATE=1) AND (NOT REMOVE)" />
			
		<!--only on uninstall-->
		<Custom Action="SetStopEdrServiceData" Before="StopEdrService" Condition='(Installed AND (REMOVE="ALL")) OR REINSTALL' />
		<Custom Action="StopEdrService" After="InstallInitialize" Condition='(Installed AND (REMOVE="ALL")) OR REINSTALL' />

		<Custom Action="SetUninstallEdrServiceData" Before="UninstallEdrService" Condition='(Installed AND (REMOVE="ALL")) OR REINSTALL' />
		<Custom Action="UninstallEdrService" After="StopEdrService" Condition='(Installed AND (REMOVE="ALL")) OR REINSTALL' />
			
		<Custom Action="CheckUninstall" After="UninstallEdrService" Condition='(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL")' />

		<Custom Action="SetDeleteEdrServiceArtefactsData" Before="DeleteEdrServiceArtefacts" Condition='(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL")' />
		<Custom Action="DeleteEdrServiceArtefacts" After="CheckUninstall" Condition='(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL")' />

		<Custom Action="SetCleanInstallDirectoryData" Before="DeleteEdrServiceArtefacts" Condition='(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL")' />
		<Custom Action="CleanInstallDirectory" After="DeleteEdrServiceArtefacts" Condition='(NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL")' />
	</InstallExecuteSequence>

	<CustomAction Id="SetActualInstallDir" Property="ACTUALINSTALLDIR" Value="[INSTALLDIR]" />

	<Binary Id="UtilJs" SourceFile="util.js" />
	<CustomAction Id="SetReinstallMode" Property="REINSTALLMODE" Value="amusv" />
	<CustomAction Id="OfferRepairing" BinaryRef="UtilJs" JScriptCall="OfferRepairing" Return="check" Execute="immediate" />

	<CustomAction Id="OnStartAdminInstallation" BinaryRef="UtilJs" JScriptCall="OnStartAdminInstallation" Return="ignore" Execute="immediate" />

	<CustomAction Id="GetSvcInstallCmdLine" BinaryRef="UtilJs" JScriptCall="GetInstallCmdLine" Return="check" />
		
	<CustomAction Id="SetRemoveExistingComodoProductsData" Property="RemoveExistingComodoProducts" Value="[WIX_UPGRADE_DETECTED]*[UILevel]*[OriginalDatabase]*[REINSTALL]*[DISABLE]*[UPDATE]*[TOKEN]*[ROOT_URL]" />
	<CustomAction Id="RemoveExistingComodoProducts" BinaryRef="UtilJs" JScriptCall="RemoveExistingProducts" Execute="deferred" Impersonate="no" Return="check" />

	<CustomAction Id="CheckUninstall" BinaryRef="UtilJs" JScriptCall="CheckUninstall" Execute="deferred" Return="check" />
		
	<CustomAction Id="OnStartInstallation" BinaryRef="UtilJs" JScriptCall="OnStartInstallation" Return="check" Impersonate="no" Execute="deferred" />
	<CustomAction Id="SetOnSuccessInstallationData" Property="OnSuccessInstallation" Value="[UILevel]*[USER_REPAIR]" />
	<CustomAction Id="OnSuccessInstallation" BinaryRef="UtilJs" JScriptCall="OnSuccessInstallation" Return="check" Execute="deferred" Impersonate="no" />
		
	<CustomAction Id="SetOnErrorInstallationData" Property="OnErrorInstallation" Value="[UILevel]*[USER_REPAIR]" />
	<CustomAction Id="OnErrorInstallation" BinaryRef="UtilJs" JScriptCall="OnErrorInstallation" Return="ignore" Execute="rollback" Impersonate="no" />
	<CustomAction Id="OnBeforeReboot" BinaryRef="UtilJs" JScriptCall="OnBeforeReboot" Return="check" Execute="deferred" Impersonate="no" />
		
	<!--<CustomAction Id="OnEndSuspendInstallation" BinaryKey="UtilJs" JScriptCall="OnEndSuspendInstallation" Return="check" Execute="deferred" />-->
	<!--<CustomAction Id="OnEndCancelInstallation" BinaryKey="UtilJs" JScriptCall="OnEndCancelInstallation" Return="check" />-->
	<CustomAction Id="SetOnStartInstallationData" Property="OnStartInstallation" Value="[OriginalDatabase]*[REINSTALL]*[REINSTALLMODE]*[DISABLE]*[UPDATE]*[UILevel]*[TOKEN]*[ROOT_URL]" />
		
	<CustomAction Id="InterruptAndRestartAfterReboot" BinaryRef="UtilJs" JScriptCall="InterruptAndRestartAfterReboot" Return="check" Execute="deferred" Impersonate="no" />
	<CustomAction Id="SetInterruptAndRestartAfterRebootData" Property="InterruptAndRestartAfterReboot" Value="[OriginalDatabase]" />

	<!-- InstallEdrService -->
	<CustomAction Id="SetInstallEdrServiceData" Property="InstallEdrService" Value='"[ACTUALINSTALLDIR]edrsvc.exe" install' />
	<CustomAction Id="InstallEdrService" BinaryRef="UtilJs" JScriptCall="InstallEdrService" Return="check" Impersonate="no" Execute="deferred" />

	<!-- EnrollEdrService -->
  <CustomAction Id="SetEnrollEdrServiceData" Property="EnrollEdrService" Value='[REINSTALL]*"[ACTUALINSTALLDIR]edrsvc.exe" enroll [SvcInstallCommandLine]' />
  <CustomAction Id="EnrollEdrService" BinaryRef="UtilJs" JScriptCall="EnrollEdrService" Return="check" Impersonate="no" Execute="deferred" />
		
	<!-- RollbackInstalledEdrService -->
	<CustomAction Id="SetRollbackInstalledEdrServiceData" Property="RollbackInstalledEdrService" Value='"[ACTUALINSTALLDIR]edrsvc.exe" uninstall' />
	<CustomAction Id="RollbackInstalledEdrService" BinaryRef="UtilJs" JScriptCall="RollbackInstalledEdrService" Return="check" Impersonate="no" Execute="rollback" />
		
	<!-- StartEdrService -->
	<CustomAction Id="SetStartEdrServiceData" Property="StartEdrService" Value='[REINSTALL]*"[ACTUALINSTALLDIR]edrsvc.exe" start' />
	<CustomAction Id="StartEdrService" BinaryRef="UtilJs" JScriptCall="StartEdrService" Return="check" Impersonate="no" Execute="deferred" />

	<!-- UninstallEdrService -->
	<CustomAction Id="SetUninstallEdrServiceData" Property="UninstallEdrService" Value='"[ACTUALINSTALLDIR]edrsvc.exe" uninstall' />
	<CustomAction Id="UninstallEdrService" BinaryRef="UtilJs" JScriptCall="UninstallEdrService" Return="ignore" Impersonate="no" Execute="deferred" />
		
	<!-- StopEdrService -->
	<CustomAction Id="SetStopEdrServiceData" Property="StopEdrService" Value='"[ACTUALINSTALLDIR]edrsvc.exe" stop' />
	<CustomAction Id="StopEdrService" BinaryRef="UtilJs" JScriptCall="StopEdrService" Return="ignore" Impersonate="no" Execute="deferred" />

	<!-- RestartEdrService -->
	<CustomAction Id="SetRestartEdrServiceData" Property="RestartEdrService" Value='"[ACTUALINSTALLDIR]edrsvc.exe" *command*' />
	<CustomAction Id="RestartEdrService" BinaryRef="UtilJs" JScriptCall="RestartEdrService" Return="ignore" Impersonate="no" Execute="deferred" />

	<!-- DeleteEdrServiceArtefacts -->
	<CustomAction Id="SetDeleteEdrServiceArtefactsData" Property="DeleteEdrServiceArtefacts" Value='[CommonAppDataFolder]HydraDragonAntivirus\edrsvc' />
	<CustomAction Id="DeleteEdrServiceArtefacts" BinaryRef="UtilJs" JScriptCall="DeleteEdrServiceArtefacts" Return="ignore" Impersonate="no" Execute="deferred" />

	<!-- CleanInstallDirectory -->
	<CustomAction Id="SetCleanInstallDirectoryData" Property="CleanInstallDirectory" Value='[ACTUALINSTALLDIR]' />
	<CustomAction Id="CleanInstallDirectory" BinaryRef="UtilJs" JScriptCall="CleanInstallDirectory" Return="ignore" Impersonate="no" Execute="deferred" />

	<!-- Enable test signing for unsigned driver support (No CMD window) -->
	<CustomAction Id="EnableTestSigning"
				  BinaryRef="UtilJs"
				  JScriptCall="EnableTestSigning"
				  Execute="deferred"
				  Impersonate="no"
				  Return="ignore" />
		
	<!--<Property Id='CmdExe'>cmd.exe</Property>
	<CustomAction Id="DeleteEdrServiceArtefacts" Property="CmdExe" ExeCommand='/c rmdir /s /q "[CommonAppDataFolder]edrsvc"' Execute="deferred" Impersonate='no' Return='ignore' />-->
		
</Include>
