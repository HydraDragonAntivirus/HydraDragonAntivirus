<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
	<?include Define.wxi ?>
	<?include BuildInfo.wxi ?>
	<Package ProductCode="$(var.strproductid)" Name="$(var.strproduct)" Language="1033" Version="$(var.strversion)" Manufacturer="HydraDragonAntivirus" UpgradeCode="$(var.upgradecode)" InstallerVersion="200" Compressed="yes" Scope="perMachine">

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." IgnoreRemoveFailure="yes" AllowSameVersionUpgrades="yes"></MajorUpgrade>
		<Upgrade Id="$(var.upgradecode)">
			<UpgradeVersion Maximum="2.0.0.0" OnlyDetect="yes" Property="OLDAGENT1INSTALLED" IgnoreRemoveFailure="yes"></UpgradeVersion>
			<!--<UpgradeVersion Maximum="$(var.strversion)" IncludeMaximum="yes" OnlyDetect="no" Property="OLDAGENT2INSTALLED" IgnoreRemoveFailure="no"></UpgradeVersion>-->
		</Upgrade>
		<Launch Condition='(VersionNT64 AND "$(var.Platform)"="x64") OR NOT (VersionNT64 OR "$(var.Platform)"="x64")' Message="This installation package ($(var.Platform)) is not supported by this processor type." />
		<Launch Condition="VersionNT &gt;= 601" Message="Current Windows version is not supported." />

		<!-- Check if Secure Boot is enabled (Registry UEFISecureBootEnabled = 1) -->
		<Property Id="SECUREBOOTENABLED" Secure="yes">
			<RegistrySearch Id="SearchSecureBoot" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SecureBoot\State" Name="UEFISecureBootEnabled" Type="raw" />
		</Property>
		<Launch Condition="NOT (SECUREBOOTENABLED = &quot;#1&quot;)" Message="Secure Boot is enabled on this system. Please disable Secure Boot in your BIOS/UEFI settings before installing [ProductName] (unsigned driver loading requires Secure Boot to be disabled)." />

		<!-- Check if Test Signing is already enabled -->
		<Property Id="TESTSIGNINGENABLED" Secure="yes">
			<RegistrySearch Id="SearchTestSigning" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\CI\Policy" Name="TestSigningPolicy" Type="raw" />
		</Property>

		<Media Cabinet="edr_agent.cab" Id="1" EmbedCab="yes" CompressionLevel="high" />

    <Property Id="MsiLogging" Value="vx" />

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
		<!--<Property Id="ARPNOMODIFY" Value="1" />-->
		<Property Id="ARPURLINFOABOUT" Value="https://www.comodo.com/support/comodo-support.php" />
		<Property Id="ARPHELPLINK" Value="https://edr.cwatch.comodo.com/help-guide" />
		<Property Id="ARPURLUPDATEINFO" Value="https://edr.cwatch.comodo.com/" />
		<Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
		
		<?include InstallSequence.wxi ?>

		<Feature Id="ProductFeature" Title="edr_installer" Level="1" AllowAbsent="no" AllowAdvertise="no" TypicalDefault="install" InstallDefault="local">
			<ComponentGroupRef Id="ProductComponents" />
			<!--<ComponentGroupRef Id="C_QSC_Scenarios" />-->
		</Feature>
	
		<Icon Id="icon.ico" SourceFile="icon.ico"/>
		<Property Id="ARPPRODUCTICON" Value="icon.ico" />

	</Package>

	<Fragment>
		<StandardDirectory Id="$(var.AppsDir)">
			<Directory Id="COMPANYNAMEGROUP" Name="HydraDragonAntivirus">
				<Directory Id="INSTALLDIR" Name="OpenEDR">
					<!--<Directory Id="QSC_DIR" Name="qsc"></Directory>-->
				</Directory>
			</Directory>
		</StandardDirectory>
		<StandardDirectory Id="$(var.SysFolder)">
			<Directory Id="DRIVERSDIR" Name="drivers">
			</Directory>
			<!-- declare system32\config\...\edrsvc to cleanup on uninstall -->
			<Directory Id="SysConfigDir" Name="config">
				<Directory Id="SysProfileDir" Name="systemprofile">
					<Directory Id="SysAppDataDir" Name="AppData">
						<Directory Id="SysLocalDir" Name="Local">
							<Directory Id="SysEdrsvcDir" Name="edrsvc">
							</Directory>
						</Directory>
					</Directory>
				</Directory>
			</Directory>
		</StandardDirectory>
	</Fragment>

	<Fragment>
		<ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
			<Component Id="Preparing" Guid="{01DBBA23-4B02-48AF-99BC-5DF1922AD981}">
				<!-- Copy config files to INSTALLDIR -->
				<CopyFile Id="CopyingDefaultCfg" SourceDirectory="TARGETDIR" SourceName="*.cfg" DestinationDirectory="INSTALLDIR" />
				<!-- Copy cacert.pem to INSTALLDIR -->
				<CopyFile Id="CopyingCacertPem" SourceDirectory="TARGETDIR" SourceName="cacert.pem" DestinationDirectory="INSTALLDIR" />

				<fire:FirewallException Id="SvcFirewallRules" Program="[INSTALLDIR]edrsvc.exe" Name="$(var.strproduct)" Scope="any" />
				<ServiceControl Id="StopEdrSvc" Name="edrsvc" Stop="uninstall" />
				<RemoveFile Id="RemovingDriver" Directory="DRIVERSDIR" Name="edrdrv.sys" On="uninstall" />
				<RegistryKey Root="HKLM" Key="Software\Owlyshield">
					<RegistryValue Name="RULES_PATH" Value="[INSTALLDIR]rules" Type="string" KeyPath="yes" />
					<RegistryValue Name="VERBOSE_LOGGING" Value="0" Type="string" />
					<RegistryValue Name="LOG_PATH" Value="[CommonAppDataFolder]edrsvc\log\owlyshield" Type="string" />
					<RegistryValue Name="REPORTS_PATH" Value="[CommonAppDataFolder]edrsvc\log\reports" Type="string" />
				</RegistryKey>
			</Component>
			<Files Include="$(var.SourceBinDir)**" />
		</ComponentGroup>
	</Fragment>
</Wix>
