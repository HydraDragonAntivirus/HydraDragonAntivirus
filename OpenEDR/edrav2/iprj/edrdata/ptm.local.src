			// SIGMA d22a2c0b-fd48-300f-ba44-d6881df81aab [high] Potentially Suspicious Command Executed Via Run Dialog Box - Registry
		{
			"eventType": "LLE_REGISTRY_KEY_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
