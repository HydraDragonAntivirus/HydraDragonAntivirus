{
  "version": 2,
  "name": "ptmPswStealer",
  "group": "patternsMatching",
  "dependencies": [ "common" ],

  "constants": {
    "basket": {
      "pswReadFiles": "PSW_READ_FILES",
      "pswDecryptSeen": "PSW_DECRYPT_SEEN"
    },
    "pswEventBaseType": {
      "MLE_PSW_STEALER": 1000011
    },
    // Browser / credential / wallet paths (imatch is case-insensitive).
    // These are READ-ONLY indicators; a single match alone does not fire.
    "pswBrowserPaths": [
      "*\\Google\\Chrome\\User Data*",
      "*\\Opera Software\\Opera Stable*",
      "*\\Opera Software\\Opera GX Stable*",
      "*\\BraveSoftware\\Brave-Browser\\User Data*",
      "*\\Microsoft\\Edge\\User Data*"
    ],
    "pswDiscordPaths": [
      "*\\Discord\\Local Storage*",
      "*\\Discord\\leveldb*"
    ],
    "pswCredentialFiles": [
      "*Cookies*",
      "*Login Data*",
      "*Web Data*",
      "*Local State*"
    ],
    "pswWalletPaths": [
      "*Electrum\\wallets*",
      "*Bitcoin\\wallets*",
      "*Ethereum\\keystore*"
    ],
    "pswExfilNames": [
      "*Credentials*",
      "*Passwords*",
      "*Tokens*"
    ],
    // Signed browser / app processes that legitimately access these paths.
    // The eventsMatching group already discards SAFE-verdict processes;
    // this list adds path-based defence for offline installs.
    "pswBenignImages": [
      "*\\chrome.exe",
      "*\\msedge.exe",
      "*\\brave.exe",
      "*\\opera.exe",
      "*\\firefox.exe",
      "*\\discord.exe",
      "*\\code.exe",
      "*\\devenv.exe",
      "*\\msedgewebview2.exe",
      "*\\teams.exe",
      "*\\ms-teams.exe",
      "*\\outlook.exe",
      "*\\onedrive.exe",
      "*\\widgets.exe"
    ],
    // Shell / interpreter parents: any process spawned by these that
    // touches credential paths is suspicious even without file count.
    "pswSuspiciousParents": [
      "*\\powershell.exe",
      "*\\cmd.exe",
      "*\\wscript.exe",
      "*\\cscript.exe",
      "*\\mshta.exe",
      "*\\python.exe",
      "*\\node.exe"
    ]
  },

  "variables": {
    "pswFileKey": [ "@event.process.id", "@event.file.rawHash" ]
  },

  "patterns": {

    //
    // PSW Stealer: browser/credential/wallet file read followed by
    // overwrite or delete of the SAME file, across 2+ distinct victims.
    // Purely behavioural - no extension lists, no API names, no hashes.
    //
    "PSW_CREDENTIAL_ACCESS": [

      // 1) Full read of a tracked-path file: remember per pid + identity
      {
        "eventType": [ "LLE_FILE_DATA_READ_FULL" ],
        "rule": {
          "saveContext": {
            "basket": "@const.basket.pswReadFiles",
            "key": "@var.ransomPathKey",
            "group": "@event.process.id",
            "lifetime": 300000,
            "data": { "file": "@event.file" }
          }
        }
      },

      // 2) Overwrite of the same file = credential DB being modified
      {
        "eventType": [ "LLE_FILE_DATA_WRITE_FULL", "LLE_FILE_DATA_CHANGE" ],
        "rule": {
          "loadContext": {
            "basket": "@const.basket.pswReadFiles",
            "key": "@var.ransomPathKey"
          },
          "saveContext": {
            "basket": "@const.basket.pswWriteAfterRead",
            "key": "@var.ransomPathKey",
            "group": "@event.process.id",
            "lifetime": 300000,
            "data": { "file": "@event.file" }
          }
        }
      },

      // 3a) Delete of a written-after-read credential file
      {
        "eventType": "LLE_FILE_DELETE",
        "rule": {
          "loadContext": {
            "basket": "@const.basket.pswWriteAfterRead",
            "key": "@var.ransomPathKey",
            "delete": true
          },
          "createEvent": {
            "eventType": "MLE_PSW_STEALER",
            "destination": "OUT",
            "clone": false,
            "data": [
              { "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
              { "name": "process", "value": "@event.process" },
              { "name": "source", "value": "@context.file" },
              { "name": "time", "value": "@event.time" },
              { "name": "tickTime", "value": "@event.tickTime" }
            ]
          }
        }
      },

      // 3b) Rename of a written-after-read credential file (relocation to
      //     staging dir before exfiltration)
      {
        "eventType": "LLE_FILE_RENAME",
        "rule": {
          "loadContext": {
            "basket": "@const.basket.pswWriteAfterRead",
            "key": "@var.ransomPathKey",
            "delete": true
          },
          "createEvent": {
            "eventType": "MLE_PSW_STEALER",
            "destination": "OUT",
            "clone": false,
            "data": [
              { "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
              { "name": "process", "value": "@event.process" },
              { "name": "source", "value": "@context.file" },
              { "name": "destination", "value": "@event.fileRenameTarget" },
              { "name": "time", "value": "@event.time" },
              { "name": "tickTime", "value": "@event.tickTime" }
            ]
          }
        }
      },

      // Cleanup on process exit
      {
        "eventType": "LLE_PROCESS_DELETE",
        "rule": {
          "deleteContext": {
            "basket": "@const.basket.pswReadFiles",
            "group": "@event.process.id"
          }
        }
      },
      {
        "eventType": "LLE_PROCESS_DELETE",
        "rule": {
          "deleteContext": {
            "basket": "@const.basket.pswWriteAfterRead",
            "group": "@event.process.id"
          }
        }
      }
    ] // PSW_CREDENTIAL_ACCESS

  }
}
