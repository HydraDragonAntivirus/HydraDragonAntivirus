  // n = 6, score = 300
  //   7275                 | jb                  0x77
  //   8b45d0               | mov                 eax, dword ptr [ebp - 0x30]
  //   85c0                 | test                eax, eax
  //   756e                 | jne                 0x70
  //   89fa                 | mov                 edx, edi
  //   31c0                 | xor                 eax, eax

  condition:
    7 of them and filesize < 114688
}


