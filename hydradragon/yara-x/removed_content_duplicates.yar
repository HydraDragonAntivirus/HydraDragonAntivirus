    /*
    	89 ??           mov     eax, ecx
    	B? 04 00 00 00  mov     edi, 4
    	99              cdq
    	F7 FF           idiv    edi
    	8B [2]          mov     edi, [ebp+arg_8]
    	8A [2]          mov     al, [edi+edx]
    	30 ??           xor     [ebx], al
    	8A ??           mov     al, [ebx]
    	4?              inc     ebx
    	88 [2]          mov     [esi+ecx], al
    */

