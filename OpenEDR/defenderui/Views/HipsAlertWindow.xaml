<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DefenderUI.Views.HipsAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HydraDragonAntivirus - HIPS Alert"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Border
        x:Name="AlertFrame"
        BorderThickness="3"
        BorderBrush="{ThemeResource StatusWarningBrush}"
        CornerRadius="12"
        Background="{ThemeResource SurfaceCardBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Üst marka barı -->
            <Grid Grid.Row="0" Padding="18,14" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="0"
                    Source="ms-appx:///Assets/AppLogo-32.png"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="1"
                    Text="HydraDragonAntivirus"
                    Style="{StaticResource TitleMediumTextStyle}"
                    VerticalAlignment="Center" />

                <Border
                    x:Name="HeaderStatusBadge"
                    Grid.Column="2"
                    CornerRadius="8"
                    Padding="10,4"
                    Background="{ThemeResource StatusWarningSoftBrush}">
                    <TextBlock
                        Text="UNKNOWN PROGRAM"
                        Style="{StaticResource CaptionTextStyle}"
                        Foreground="{ThemeResource StatusWarningBrush}" />
                </Border>
            </Grid>

            <!-- Orta bölüm: HIPS bilgisi -->
            <StackPanel Grid.Row="1" Padding="18,10,18,12" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="48"
                        Height="48"
                        CornerRadius="12"
                        VerticalAlignment="Top"
                        Background="{ThemeResource StatusWarningSoftBrush}">
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontSize="24"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Foreground="{ThemeResource StatusWarningBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="An unknown program is starting"
                            Style="{StaticResource BodyLargeTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="It was automatically suspended until you decide:"
                            Style="{StaticResource BodyMediumTextStyle}"
                            TextWrapping="Wrap"
                            Opacity="0.9" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Padding="16,14"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    Background="{ThemeResource SurfaceCardBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Program"
                            Style="{StaticResource CaptionTextStyle}"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            x:Name="ProgramNameText"
                            Text="{x:Bind ProgramName}"
                            Style="{StaticResource BodyLargeTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ProgramPathText"
                            Text="{x:Bind ProgramPath}"
                            Style="{StaticResource BodyMediumTextStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Alt bölüm: HIPS aksiyonları -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Padding="18,0,18,16">
                <Button
                    x:Name="AskButton"
                    Content="Ask"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="AskButton_Click" />
                <Button
                    x:Name="BlockButton"
                    Content="Block"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="BlockButton_Click" />
                <Button
                    x:Name="QuarantineButton"
                    Content="Quarantine"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="QuarantineButton_Click" />
                <Button
                    x:Name="AllowButton"
                    Content="Allow Forever"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="AllowButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>