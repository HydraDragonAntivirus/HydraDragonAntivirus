<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/6.0.2>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <Platforms>x86</Platforms>
    <ProjectGuid>{b7302b2d-5ee2-4660-a1c8-a8d560d9c581}</ProjectGuid>
    <OutputName>upgrade</OutputName>
    <OutputType>Package</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VerboseOutput>true</VerboseOutput>
    <HarvestDirectoryGenerateGuidsNow>true</HarvestDirectoryGenerateGuidsNow>
    <HarvestDirectorySuppressFragments>true</HarvestDirectorySuppressFragments>
    <HarvestDirectorySuppressRegistry>true</HarvestDirectorySuppressRegistry>
    <HarvestDirectorySuppressRootDirectory>true</HarvestDirectorySuppressRootDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformName Condition=" '$(Platform)' == 'x86' ">Win32</PlatformName>
  </PropertyGroup>

  <Import Project="..\..\..\build\vs2017\consts.props" />

  <PropertyGroup>
    <OutputPath>$(CmdRootDir)\out\upgrade\$(CmdOutDirName)\</OutputPath>
    <IntermediateOutputPath>$(CmdRootDir)\out\temp\$(CmdOutDirName)\$(OutputName)\</IntermediateOutputPath>
    <DefineConstants>BIN_PATH=$(CmdRootDir)\out\bin\;OUT_DIR_NAME=$(CmdOutDirName)\;SourceBinDir32=$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\Win32\;SourceBinDir64=$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64</DefineConstants>
    <IncludeSearchPaths>..\..\src;..\..\..\installation\src</IncludeSearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Product.wxs">
      <Link>Product.wxs</Link>
    </Compile>
    <Compile Include="$(IntermediateOutputPath)BinaryFilesWin32.wxs">
      <Link>BinaryFilesWin32.wxs</Link>
    </Compile>
    <Compile Include="$(IntermediateOutputPath)BinaryFilesX64.wxs">
      <Link>BinaryFilesX64.wxs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\installation\src\Define.wxi">
      <Link>Define.wxi</Link>
    </Content>
    <Content Include="..\..\..\installation\src\BuildInfo.wxi">
      <Link>BuildInfo.wxi</Link>
    </Content>
    <Content Include="..\..\..\installation\src\InstallSequence.wxi">
      <Link>InstallSequence.wxi</Link>
    </Content>
    <Content Include="..\..\..\installation\src\util.js">
      <Link>util.js</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="..\..\src" />
    <BindPath Include="..\..\..\installation\src" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2 />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2 />
  </ItemGroup>

  <Target Name="PrepareUpgradePayload" BeforeTargets="CoreCompile">
    <Exec Command='if exist "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)" rd "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)" /S /Q' />
    <Exec Command='md "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\Win32"' />
    <Exec Command='md "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64"' />
    <Exec Command='xcopy "$(CmdRootDir)\out\bin\win-$(Configuration)-Win32" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\Win32" /Q /E /I /Exclude:$(ProjectDir)..\..\..\installation\src\exclude.list' />
    <Exec Command='xcopy "$(CmdRootDir)\out\bin\win-$(Configuration)-x64" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64" /Q /E /I /Exclude:$(ProjectDir)..\..\..\installation\src\exclude.list' />
    <Exec Command='FOR /r "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\Win32" %%i in (*.cfg, *.qsc, ptm.*, evm.*, policy.l?c) do "$(CmdRootDir)\out\bin\win-$(Configuration)-Win32\edrcon.exe" file encrypt -f "%%~i" -o "%%~i.new" -e aes' />
    <Exec Command='FOR /r "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\Win32" %%i in (*.new) do del "%%~dpni" /F /Q &amp; ren "%%~i" "%%~ni"' />
    <Exec Command='FOR /r "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64" %%i in (*.cfg, *.qsc, ptm.*, evm.*, policy.l?c) do "$(CmdRootDir)\out\bin\win-$(Configuration)-x64\edrcon.exe" file encrypt -f "%%~i" -o "%%~i.new" -e aes' />
    <Exec Command='FOR /r "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64" %%i in (*.new) do del "%%~dpni" /F /Q &amp; ren "%%~i" "%%~ni"' />
    <HeatDirectory
      ToolPath="$(HeatToolDir)"
      Directory="$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\Win32"
      OutputFile="$(IntermediateOutputPath)BinaryFilesWin32.wxs"
      GenerateGuidsNow="true"
      SuppressFragments="true"
      SuppressRegistry="true"
      ComponentGroupName="BinaryFilesWin32"
      PreprocessorVariable="var.SourceBinDir32"
      SuppressRootDirectory="true"
      DirectoryRefId="INSTALLDIRX86" />
    <HeatDirectory
      ToolPath="$(HeatToolDir)"
      Directory="$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64"
      OutputFile="$(IntermediateOutputPath)BinaryFilesX64.wxs"
      GenerateGuidsNow="true"
      SuppressFragments="true"
      SuppressRegistry="true"
      ComponentGroupName="BinaryFilesX64"
      PreprocessorVariable="var.SourceBinDir64"
      SuppressRootDirectory="true"
      DirectoryRefId="INSTALLDIRX64" />
  </Target>
</Project>
