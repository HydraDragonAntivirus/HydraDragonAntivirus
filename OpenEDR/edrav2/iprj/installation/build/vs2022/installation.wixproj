<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>6c957042-f2be-441c-9cd7-589f51f0d842</ProjectGuid>
    <OutputName>installation</OutputName>
    <OutputType>Package</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VerboseOutput>true</VerboseOutput>
    <HarvestDirectoryGenerateGuidsNow>true</HarvestDirectoryGenerateGuidsNow>
    <HarvestDirectorySuppressFragments>true</HarvestDirectorySuppressFragments>
    <HarvestDirectorySuppressRegistry>true</HarvestDirectorySuppressRegistry>
    <HarvestDirectorySuppressRootDirectory>true</HarvestDirectorySuppressRootDirectory>
    <AcceptEula>wix6</AcceptEula>
  </PropertyGroup>
  <PropertyGroup>
    <PlatformName Condition=" '$(Platform)' == 'x86' ">Win32</PlatformName>
    <PlatformName Condition=" '$(Platform)' == 'x64' ">x64</PlatformName>
  </PropertyGroup>
  <Import Project="..\..\..\build\vs2022\consts.props" />
  <PropertyGroup>
    <OutputPath>$(CmdRootDir)\out\install\$(CmdOutDirName)\</OutputPath>
    <IntermediateOutputPath>$(CmdRootDir)\out\temp\$(CmdOutDirName)\$(OutputName)\</IntermediateOutputPath>
    <DefineConstants>BIN_PATH=$(CmdRootDir)\out\bin\;OUT_DIR_NAME=$(CmdOutDirName)\;SourceBinDir=$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\</DefineConstants>
    <IncludeSearchPaths>..\..\src</IncludeSearchPaths>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Product.wxs">
      <Link>Product.wxs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Define.wxi">
      <Link>Define.wxi</Link>
    </Content>
    <Content Include="..\..\src\BuildInfo.wxi">
      <Link>BuildInfo.wxi</Link>
    </Content>
    <Content Include="..\..\src\InstallSequence.wxi">
      <Link>InstallSequence.wxi</Link>
    </Content>
    <Content Include="..\..\src\util.js">
      <Link>util.js</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <BindPath Include="..\..\src" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2" />
  </ItemGroup>
  <Target Name="ValidateSourceBinaries" BeforeTargets="PrepareInstallationPayload">
    <Warning Condition="!Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Text="Source binaries not found in '$(CmdRootDir)\out\bin\$(CmdOutDirName)'. The installer will be empty." />
  </Target>
  <Target Name="PrepareInstallationPayload" BeforeTargets="CoreCompile">
    <Exec Command="if exist &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot; rd &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot; /S /Q" />
    <Exec Command="md &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot;" />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command="xcopy &quot;$(CmdRootDir)\out\bin\$(CmdOutDirName)&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot; /Q /E /I /Exclude:$(ProjectDir)..\..\src\exclude.list" />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command="FOR /r &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot; %%i in (*.cfg, *.qsc, *.src, *.act) do &quot;$(CmdRootDir)\out\bin\$(CmdOutDirName)\edrcon.exe&quot; file encrypt -f &quot;%%~i&quot; -o &quot;%%~i.new&quot; -e aes" />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command="FOR /r &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot; %%i in (*evm.cloud.src, *evm.local.src) do copy &quot;%%~i&quot; &quot;%%~i.new&quot; /Y" />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command="FOR /r &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)&quot; %%i in (*.new) do del &quot;%%~dpni&quot; /F /Q &amp; ren &quot;%%~i&quot; &quot;%%~ni&quot;" />
    <Exec Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\WinDivert\WinDivert.dll&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\&quot;" />
    <Exec Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\WinDivert\WinDivert64.sys&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\&quot;" />
    <Exec Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\owlyshield_predict\target\release\owlyshield_ransom.dll&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\&quot;" />
    <Exec Command="xcopy /Y /D /E /I &quot;$(ProjectDir)..\..\..\..\firewall-rules&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\firewall-rules\&quot;" />
    <Exec Command="xcopy /Y /D /E /I &quot;$(ProjectDir)..\..\..\..\..\owlyshield_predict\models&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\models\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\MBRFilter\x64\Win8Release')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\MBRFilter\x64\Win8Release\MBRFilter.*&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\&quot;" />
    <Exec Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\edrgui\edrgui.exe&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\um_engine.exe')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\um_engine.exe&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\elam_installer.exe')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\elam_installer.exe&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum_ppl_runner.exe')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum_ppl_runner.exe&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\AppData\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\server.exe')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\server.exe&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\System32\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\&quot;" />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys')" Command="xcopy /Y /D &quot;$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys&quot; &quot;$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\Sanctum\AppData\&quot;" />
  </Target>
</Project>