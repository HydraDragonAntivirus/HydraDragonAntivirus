// ===== removed from rules/clean_rules.yar (20260620_190954) =====
rule Cobaltbaltstrike_Beacon_XORed_x86 {
  meta:
    author      = "Avast Threat Intel Team"
    description = "Detects CobaltStrike payloads"
    reference   = "https://github.com/avast/ioc"

  strings:
    // x86 xor decrypt loop
    // 52 bytes variant
    $h01 = { FC E8 ?? 00 00 00 [0-32] EB 27 ?? 8B ?? 83 ?? 04 8B ?? 31 ?? 83 ?? 04 ?? 8B ?? 31 ?? 89 ?? 31 ?? 83 ?? 04 83 ?? 04 31 ?? 39 ?? 74 02 EB EA ?? FF ?? E8 D4 FF FF FF }
    // 56 bytes variant
    $h02 = { FC E8 ?? 00 00 00 [0-32] EB 2B ?? 8B ?? 00 83 C5 04 8B ?? 00 31 ?? 83 C5 04 55 8B ?? 00 31 ?? 89 ?? 00 31 ?? 83 C5 04 83 ?? 04 31 ?? 39 ?? 74 02 EB E8 ?? FF ?? E8 D0 FF FF FF }
    // end of xor decrypt loop
    $h11 = { 74 02 EB (E8 | EA) ?? FF ?? E8 (D0 | D4) FF FF FF }

  condition:
    any of ($h0*) and (
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x4D5AE800 or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x904D5AE8 or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x90904D5A or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x9090904D or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x90909090
    )
}


// ===== removed from rules/clean_rules.yar (20260620_190954) =====
rule Cobaltbaltstrike_Beacon_XORed_x64 {
  meta:
    author      = "Avast Threat Intel Team"
    description = "Detects CobaltStrike payloads"
    reference   = "https://github.com/avast/ioc"

  strings:
    // x64 xor decrypt loop
    $h01 = { FC 48 83 E4 F0 EB 33 5D 8B 45 00 48 83 C5 04 8B 4D 00 31 C1 48 83 C5 04 55 8B 55 00 31 C2 89 55 00 31 D0 48 83 C5 04 83 E9 04 31 D2 39 D1 74 02 EB E7 58 FC 48 83 E4 F0 FF D0 E8 C8 FF FF FF }
    // end of xor decrypt loop
    $h11 = { FC 48 83 E4 F0 FF D0 E8 C8 FF FF FF }

  condition:
    $h01 and (
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x4D5A4152 or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x904D5A41 or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x90904D5A or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x9090904D or
      uint32be(@h11 + 12) ^ uint32be(@h11 + 20) == 0x90909090
    )
}


