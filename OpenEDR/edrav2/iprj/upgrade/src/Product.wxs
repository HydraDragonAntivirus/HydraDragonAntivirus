<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
    <?include Define.wxi ?>
    <?include BuildInfo.wxi ?>
    <Package ProductCode="$(var.strproductid)" Name="$(var.strproduct)" Language="1033" Version="$(var.strversion)" Manufacturer="HydraDragonAntivirus" UpgradeCode="$(var.upgradecode)" InstallerVersion="200" Compressed="yes" Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." IgnoreRemoveFailure="yes" AllowSameVersionUpgrades="yes" />

        <Upgrade Id="$(var.upgradecode)">
            <UpgradeVersion Maximum="2.0.0.0" OnlyDetect="yes" Property="OLDAGENT1INSTALLED" IgnoreRemoveFailure="yes" />
        </Upgrade>

        <Launch Condition="VersionNT &gt;= 601" Message="Current Windows version is not supported." />

        <!-- Check if Secure Boot is enabled (Registry UEFISecureBootEnabled = 1) -->
        <Property Id="SECUREBOOTENABLED" Secure="yes">
            <RegistrySearch Id="SearchSecureBoot" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SecureBoot\State" Name="UEFISecureBootEnabled" Type="raw" />
        </Property>
        <Launch Condition="NOT (SECUREBOOTENABLED = &quot;#1&quot;)" Message="Secure Boot is enabled on this system. Please disable Secure Boot in your BIOS/UEFI settings before installing [ProductName] (unsigned driver loading requires Secure Boot to be disabled)." />

        <Media Cabinet="edr_agent.cab" Id="1" EmbedCab="yes" CompressionLevel="high" />

        <Property Id="MsiLogging" Value="vx" />
        <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
        <Property Id="ARPURLINFOABOUT" Value="https://www.comodo.com/support/comodo-support.php" />
        <Property Id="ARPHELPLINK" Value="https://edr.cwatch.comodo.com/help-guide" />
        <Property Id="ARPURLUPDATEINFO" Value="https://edr.cwatch.comodo.com/" />
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
        
        <?include InstallSequence.wxi ?>

        <InstallExecuteSequence>
            <Custom Action="SetActualInstallDirTarget" After="SetActualInstallDir" />
        </InstallExecuteSequence>

        <CustomAction Id="SetActualInstallDirTarget" Property="ACTUALINSTALLDIR" Value="[INSTALLDIR_PLATFORM]" />
        
        <Feature Id="ProductFeature" Level="1" AllowAbsent="no" AllowAdvertise="no" TypicalDefault="install" InstallDefault="local">
            <?if $(var.Platform) = "x64" ?>
                <ComponentGroupRef Id="ProductComponentsX64" />
            <?else?>
                <ComponentGroupRef Id="ProductComponentsX86" />
            <?endif?>
        </Feature>
    
        <Icon Id="icon.ico" SourceFile="icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    </Package>

    <Fragment>
        <StandardDirectory Id="$(var.AppsDir)">
            <Directory Id="COMPANYNAMEGROUP" Name="HydraDragonAntivirus">
                <Directory Id="INSTALLDIR" Name="OpenEDR">
                    <?if $(var.Platform) = "x64" ?>
                        <Directory Id="INSTALLDIR_PLATFORM" Name="x64">
                            <Directory Id="MODELSDIR_X64" Name="models" />
                            <Directory Id="SANCTUMDIR_X64" Name="Sanctum" />
                        </Directory>
                    <?else?>
                        <Directory Id="INSTALLDIR_PLATFORM" Name="x86">
                            <Directory Id="MODELSDIR_X86" Name="models" />
                            <Directory Id="SANCTUMDIR_X86" Name="Sanctum" />
                        </Directory>
                    <?endif?>
                </Directory>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="$(var.SysFolder)">
            <Directory Id="DRIVERSDIR" Name="drivers" />
            <Directory Id="SysConfigDir" Name="config">
                <Directory Id="SysProfileDir" Name="systemprofile">
                    <Directory Id="SysAppDataDir" Name="AppData">
                        <Directory Id="SysLocalDir" Name="Local">
                            <Directory Id="SysEdrsvcDir" Name="edrsvc" />
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
        </StandardDirectory>
    </Fragment>

    <Fragment>
        <?if $(var.Platform) = "x64" ?>
            <ComponentGroup Id="ProductComponentsX64" Directory="INSTALLDIR_PLATFORM">
                <Component Id="ModelBinariesX64" Guid="{A2D1B36C-CE4F-4638-B7E0-7A9EF73BF640}" Directory="MODELSDIR_X64">
                    <File Id="JS_Model_Mpk_X64" Source="$(var.SourceBinDir64)models\js_model.mpk" KeyPath="yes" />
                    <File Id="PE_Model_Mpk_X64" Source="$(var.SourceBinDir64)models\pe_model.mpk" />
                </Component>
                <Component Id="SanctumSysComponentsX64" Guid="{4C9A23E1-71A2-4D93-BF29-48A5E12E571B}" Directory="DRIVERSDIR">
                    <File Id="SanctumSysFileX64" Source="$(var.SourceBinDir64)Sanctum\sanctum.sys" KeyPath="yes" />
                    <RemoveFile Id="RemovingSanctumDriverX64" Directory="DRIVERSDIR" Name="sanctum.sys" On="uninstall" />
                </Component>
                <Component Id="SanctumDllComponentX64" Guid="{3E298F11-4A56-4B82-9CD3-79A120FB342D}" Directory="$(var.SysFolder)">
                    <File Id="SanctumDllFileX64" Source="$(var.SourceBinDir64)Sanctum\sanctum.dll" KeyPath="yes" />
                    <RemoveFile Id="RemovingSanctumDllX64" Directory="$(var.SysFolder)" Name="sanctum.dll" On="uninstall" />
                </Component>
                <Component Id="ElamInstallerComponentX64" Guid="{9C3E7A21-5B4F-4D68-8E92-1F0A6C7D2B45}" Directory="SANCTUMDIR_X64">
                    <File Id="ElamInstallerFileX64" Source="$(var.SourceBinDir64)Sanctum\elam_installer.exe" KeyPath="yes" />
                    <ServiceInstall Id="ElamInstallerServiceInstallX64" Name="elam_installer" DisplayName="Sanctum ELAM Installer" Description="Runs elam_installer.exe automatically at boot to register sanctum_elam." Type="ownProcess" Start="auto" ErrorControl="normal" Vital="no" />
                </Component>
                <Component Id="PreparingX64" Guid="{4BEB1048-A6EB-4021-ADAA-74A75EDA5EAE}">
                    <CopyFile Id="CopyingDefaultCfgX64" SourceDirectory="TARGETDIR" SourceName="*.cfg" DestinationDirectory="INSTALLDIR_PLATFORM" />
                    <CopyFile Id="CopyingCacertPemX64" SourceDirectory="TARGETDIR" SourceName="cacert.pem" DestinationDirectory="INSTALLDIR_PLATFORM" />
                    <fire:FirewallException Id="SvcFirewallRulesX64" Program="[INSTALLDIR_PLATFORM]edrsvc.exe" Name="$(var.strproduct)" Scope="any" />
                    <ServiceControl Id="StopEdrSvcX64" Name="edrsvc" Stop="uninstall" />
                    <ServiceControl Id="StopSanctumRunnerX64" Name="sanctum_ppl_runner" Stop="uninstall" Remove="uninstall" />
                    <ServiceControl Id="StopElamInstallerX64" Name="elam_installer" Stop="uninstall" Remove="uninstall" />
                    <ServiceControl Id="StopElamDriverX64" Name="sanctum_elam" Stop="uninstall" Remove="uninstall" />
                    <RemoveFile Id="RemovingDriverX64" Directory="DRIVERSDIR" Name="edrdrv.sys" On="uninstall" />
                    <RemoveFile Id="RemovingMbrFilterDriverX64" Directory="DRIVERSDIR" Name="MBRFilter.sys" On="uninstall" />
                    <RegistryKey Root="HKLM" Key="Software\Owlyshield">
                        <RegistryValue Name="RULES_PATH" Value="[INSTALLDIR_PLATFORM]rules" Type="string" KeyPath="yes" />
                        <RegistryValue Name="VERBOSE_LOGGING" Value="0" Type="string" />
                        <RegistryValue Name="LOG_PATH" Value="[INSTALLDIR_PLATFORM]log" Type="string" />
                        <RegistryValue Name="REPORTS_PATH" Value="[INSTALLDIR_PLATFORM]reports" Type="string" />
                        <RegistryValue Name="MONITOR_ALL_APIS" Value="0" Type="string" />
                        <RegistryValue Name="TRUST_COMODO_CLOUD" Value="1" Type="string" />
                    </RegistryKey>
                    <RegistryKey Root="HKLM" Key="Software\Owlyshield\SDK">
                        <RegistryValue Name="RULES_PATH" Value="[INSTALLDIR_PLATFORM]firewall-rules" Type="string" />
                    </RegistryKey>
                </Component>
                <Files Include="$(var.SourceBinDir64)**">
                    <Exclude Files="$(var.SourceBinDir64)models\**" />
                    <Exclude Files="$(var.SourceBinDir64)Sanctum\sanctum.sys" />
                    <Exclude Files="$(var.SourceBinDir64)Sanctum\sanctum.dll" />
                    <Exclude Files="$(var.SourceBinDir64)Sanctum\elam_installer.exe" />
                </Files>
            </ComponentGroup>
        <?else?>
            <ComponentGroup Id="ProductComponentsX86" Directory="INSTALLDIR_PLATFORM">
                <Component Id="ModelBinariesX86" Guid="{074D90EE-0D34-406C-B434-6FB8D2DF3EAD}" Directory="MODELSDIR_X86">
                    <File Id="JS_Model_Mpk_X86" Source="$(var.SourceBinDir32)models\js_model.mpk" KeyPath="yes" />
                    <File Id="PE_Model_Mpk_X86" Source="$(var.SourceBinDir32)models\pe_model.mpk" />
                </Component>
                <Component Id="SanctumSysComponentsX86" Guid="{4C9A23E1-71A2-4D93-BF29-48A5E12E571C}" Directory="DRIVERSDIR">
                    <File Id="SanctumSysFileX86" Source="$(var.SourceBinDir32)Sanctum\sanctum.sys" KeyPath="yes" />
                    <RemoveFile Id="RemovingSanctumDriverX86" Directory="DRIVERSDIR" Name="sanctum.sys" On="uninstall" />
                </Component>
                <Component Id="SanctumDllComponentX86" Guid="{3E298F11-4A56-4B82-9CD3-79A120FB342E}" Directory="$(var.SysFolder)">
                    <File Id="SanctumDllFileX86" Source="$(var.SourceBinDir32)Sanctum\sanctum.dll" KeyPath="yes" />
                    <RemoveFile Id="RemovingSanctumDllX86" Directory="$(var.SysFolder)" Name="sanctum.dll" On="uninstall" />
                </Component>
                <Component Id="ElamInstallerComponentX86" Guid="{0D4F8B32-6C5A-4E79-9FA3-2A1B7D8E3C56}" Directory="SANCTUMDIR_X86">
                    <File Id="ElamInstallerFileX86" Source="$(var.SourceBinDir32)Sanctum\elam_installer.exe" KeyPath="yes" />
                    <ServiceInstall Id="ElamInstallerServiceInstallX86" Name="elam_installer" DisplayName="Sanctum ELAM Installer" Description="Runs elam_installer.exe automatically at boot to register sanctum_elam." Type="ownProcess" Start="auto" ErrorControl="normal" Vital="no" />
                </Component>
                <Component Id="PreparingX86" Guid="{01DBBA23-4B02-48AF-99BC-5DF1922AD981}">
                    <CopyFile Id="CopyingDefaultCfgX86" SourceDirectory="TARGETDIR" SourceName="*.cfg" DestinationDirectory="INSTALLDIR_PLATFORM" />
                    <CopyFile Id="CopyingCacertPemX86" SourceDirectory="TARGETDIR" SourceName="cacert.pem" DestinationDirectory="INSTALLDIR_PLATFORM" />
                    <fire:FirewallException Id="SvcFirewallRulesX86" Program="[INSTALLDIR_PLATFORM]edrsvc.exe" Name="$(var.strproduct)" Scope="any" />
                    <ServiceControl Id="StopEdrSvcX86" Name="edrsvc" Stop="uninstall" />
                    <ServiceControl Id="StopSanctumRunnerX86" Name="sanctum_ppl_runner" Stop="uninstall" Remove="uninstall" />
                    <ServiceControl Id="StopElamInstallerX86" Name="elam_installer" Stop="uninstall" Remove="uninstall" />
                    <ServiceControl Id="StopElamDriverX86" Name="sanctum_elam" Stop="uninstall" Remove="uninstall" />
                    <RemoveFile Id="RemovingDriverX86" Directory="DRIVERSDIR" Name="edrdrv.sys" On="uninstall" />
                    <RemoveFile Id="RemovingMbrFilterDriverX86" Directory="DRIVERSDIR" Name="MBRFilter.sys" On="uninstall" />
                    <RegistryKey Root="HKLM" Key="Software\Owlyshield">
                        <RegistryValue Name="RULES_PATH" Value="[INSTALLDIR_PLATFORM]rules" Type="string" KeyPath="yes" />
                        <RegistryValue Name="VERBOSE_LOGGING" Value="0" Type="string" />
                        <RegistryValue Name="LOG_PATH" Value="[INSTALLDIR_PLATFORM]log" Type="string" />
                        <RegistryValue Name="REPORTS_PATH" Value="[INSTALLDIR_PLATFORM]reports" Type="string" />
                        <RegistryValue Name="TRUST_COMODO_CLOUD" Value="1" Type="string" />
                    </RegistryKey>
                    <!-- Firewall SDK rule path -->
                    <RegistryKey Root="HKLM" Key="Software\Owlyshield\SDK">
                        <RegistryValue Name="RULES_PATH" Value="[INSTALLDIR_PLATFORM]firewall-rules" Type="string" />
                        <RegistryValue Name="SANCTUM_PATH" Value="[INSTALLDIR_PLATFORM]Sanctum" Type="string" />
                    </RegistryKey>
                </Component>
                <Files Include="$(var.SourceBinDir32)**">
                    <Exclude Files="$(var.SourceBinDir32)models\**" />
                    <Exclude Files="$(var.SourceBinDir32)Sanctum\sanctum.sys" />
                    <Exclude Files="$(var.SourceBinDir32)Sanctum\sanctum.dll" />
                    <Exclude Files="$(var.SourceBinDir32)Sanctum\elam_installer.exe" />
                </Files>
            </ComponentGroup>
        <?endif?>
    </Fragment>
</Wix>
