//
// Local policy definition for PatternsMatching
//
{
	"version": 2,
	"name": "ptmLocal",
	"group": "patternsMatching",
	"dependencies": [ "common" ],

	"constants": {
		"basket": {
			"fileReadWrite": "FILE_COPY_READ_WRITE",
			"fileWriteRead": "FILE_COPY_WRITE_READ"
		},
		"ransomShadowEventBaseType": {
			"MLE_RANSOM_SHADOW_COPY_DELETE": 1000009
		},
		"ransomShadowDeleteCmdLines": [
			"*vssadmin*delete shadows*",
			"*wmic*shadowcopy delete*",
			"*wmic*shadowcopy*delete*",
			"*wbadmin*delete catalog*",
			"*bcdedit*recoveryenabled*no*",
			"*wbadmin*delete systemstatebackup*",
			"*vssadmin*resize shadowstorage*"
		],
		"ransomEventBaseType": {
			"MLE_RANSOM_BEHAVIOR": 1000008
		},
		"ransomBehaviorEventBaseType": {
			"MLE_RANSOM_BEHAVIOR": 1000008
		},
		"ransomBasket": {
			"readWrite": "RANSOM_FILE_READ_WRITE",
			"processCounter": "RANSOM_PROCESS_COUNTER"
		},
				"powershellEventBaseType": {
			"MLE_POWERSHELL_MALICIOUS": 1000012
		},
		"flsEventBaseType": {
			"MLE_FLS_MALICIOUS_VERDICT": 1000010
		},
		"pswEventBaseType": {
			"MLE_PSW_STEALER": 1000011
		},
		"pswBasket": {
			"pswCredRead": "PSW_CRED_READ",
			"pswReadFiles": "PSW_READ_FILES",
			"pswWriteAfterRead": "PSW_WRITE_AFTER_READ"
		},
		// Credential / browser data paths (imatch is case-insensitive)
		"pswCredPaths": [
			"*\\Google\\Chrome\\User Data*",
			"*\\Microsoft\\Edge\\User Data*",
			"*\\BraveSoftware\\Brave-Browser\\User Data*",
			"*\\Opera Software\\Opera Stable*",
			"*\\Opera Software\\Opera GX Stable*",
			"*\\Discord\\Local Storage*",
			"*\\Discord\\leveldb*",
			"*Electrum\\wallets*",
			"*Bitcoin\\wallets*",
			"*Ethereum\\keystore*",
			"*Cookies*",
			"*Login Data*",
			"*Web Data*",
			"*Local State*"
		],
		// System and browser cache paths excluded from ransomware tripping (FP reduction)
		"ransomSystemExclusions": [
			"*\\Windows\\*",
			"*\\Program Files\\*",
			"*\\Program Files (x86)\\*",
			"*\\ProgramData\\Microsoft\\*",
			"*\\AppData\\Local\\Packages\\*",
			"*\\AppData\\Local\\Microsoft\\Edge\\User Data\\EBWebView\\*",
			"*\\AppData\\Local\\Temp\\*",
			"*\\Temp\\*"
		]
	},

	"variables": {
		"copyFileKey": [ "@event.process.id", "@event.file.rawHash" ],
		"ransomPathKey": [ "@event.process.id", "@event.file.rawPath" ]
	},

	"patterns": {
		"POWERSHELL_LONG_BASE64": [
			// Case 1: abstractPath available
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.process.imageFile.abstractPath" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.process.imageFile.rawPath" ]
									}
								]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*-e *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-en *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-enc *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-encodedcommand *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									}
								]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_POWERSHELL_MALICIOUS",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.powershellEventBaseType.MLE_POWERSHELL_MALICIOUS" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},
			// Case 2: abstractPath missing -> use rawPath
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.process.imageFile.abstractPath" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.process.imageFile.rawPath" ]
									}
								]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*-e *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-en *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-enc *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-encodedcommand *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.process.cmdLine" ]
									}
								]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_POWERSHELL_MALICIOUS",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.powershellEventBaseType.MLE_POWERSHELL_MALICIOUS" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			}
		], // POWERSHELL_LONG_BASE64



		//
		// Pattern for copy-file READ-WRITE scenario
		//
		"FILE_COPY_READ_WRITE": [

			// Detect full read and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey"
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@event.file"
							},
							{
								"name": "source",
								"value": "@context.file"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							},
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileReadWrite",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_READ_WRITE

		//
		// Pattern for copy-file WRITE-READ scenario
		//
		"FILE_COPY_WRITE_READ": [

			// Detect full write and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"maxCopyCount": 100,
						"data": {
							"file": "@event.file",
							"time": "@event.time",
							"tickTime": "@event.tickTime"
						}
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"delete": true
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@context.file"
							},
							{
								"name": "source",
								"value": "@event.file"
							},
							{
								"name": "time",
								"value": "@context.time"
							},
							{
								"name": "tickTime",
								"value": "@context.tickTime"
							}
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileWriteRead",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_WRITE_READ

		//
		//
		// PSW Stealer: credential file full-read + outbound network connect.
		// A process that reads credential databases and then connects out
		// is exfiltrating stolen data. No destructive op needed.
		//
		"PSW_CREDENTIAL_ACCESS": [

			// 1a) Full sequential read of a credential/browser data file
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "@const.pswCredPaths",
						"args": [ "@event.file.uniquePath" ]
					},
					"saveContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 1b) Memory-mapped section read of a credential/browser data file
			{
				"eventType": "LLE_FILE_MAP_READ",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "@const.pswCredPaths",
						"args": [ "@event.file.uniquePath" ]
					},
					"saveContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 2a) Outbound network connect - abstractPath available
			{
				"eventType": "LLE_NETWORK_CONNECT_OUT",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "?*",
						"args": [ "@event.process.imageFile.abstractPath" ]
					},
					"loadContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id"
					},
					"createEvent": {
						"eventType": "MLE_PSW_STEALER",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},
			// 2b) Outbound network connect - rawPath fallback
			{
				"eventType": "LLE_NETWORK_CONNECT_OUT",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "?*",
						"args": [ "@event.process.imageFile.abstractPath" ]
					},
					"loadContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id"
					},
					"createEvent": {
						"eventType": "MLE_PSW_STEALER",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			},

			// Cleanup on process exit
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"group": "@event.process.id"
					}
				}
			}
		] // PSW_CREDENTIAL_ACCESS

,
		// Pattern for shadow-copy deletion: vssadmin/wmic/wbadmin wiping
		// volume shadow copies is a near-zero-FP destructive footprint.
		//
		"RANSOM_SHADOW_COPY_DELETE": [
			// Case 1: abstractPath available
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.ransomShadowDeleteCmdLines",
								"args": [ "@event.process.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_SHADOW_COPY_DELETE",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomShadowEventBaseType.MLE_RANSOM_SHADOW_COPY_DELETE" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},
			// Case 2: rawPath fallback
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.ransomShadowDeleteCmdLines",
								"args": [ "@event.process.cmdLine" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_SHADOW_COPY_DELETE",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomShadowEventBaseType.MLE_RANSOM_SHADOW_COPY_DELETE" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			}
		], // RANSOM_SHADOW_COPY_DELETE

		//
		// Pattern for keeping track of process distinct hits
		//
		"RANSOM_COUNTER_INIT": [
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"saveContext": {
						"basket": "@const.ransomBasket.processCounter",
						"key": "@event.process.id",
						"lifetime": 86400000,
						"data": {
							"hitCount": 0
						}
					}
				}
			},
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.ransomBasket.processCounter",
						"group": "@event.process.id"
					}
				}
			}
		], // RANSOM_COUNTER_INIT

		//
		// Pattern for Ransomware destructive overwrite / in-place encryption behavior
		// Detects a process reading a file (sequential or mmap) and subsequently overwriting, modifying, renaming or deleting it.
		//
		"RANSOM_BEHAVIOR": [

			// Step 1a: Process reads a full file -> save context to ransomBasket
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"saveContext": {
						"basket": "@const.ransomBasket.readWrite",
						"key": "@var.ransomPathKey",
						"group": "@event.process.id",
						"lifetime": 120000,
						"data": {
							"file": "@event.file"
						}
					}
				}
			},

			// Step 1b: Process memory-maps a file for read -> save context to ransomBasket
			{
				"eventType": "LLE_FILE_MAP_READ",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"saveContext": {
						"basket": "@const.ransomBasket.readWrite",
						"key": "@var.ransomPathKey",
						"group": "@event.process.id",
						"lifetime": 120000,
						"data": {
							"file": "@event.file"
						}
					}
				}
			},

			// Step 2a: File write -> trigger Candidate
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Step 2b: Memory-mapped write -> trigger Candidate
			{
				"eventType": "LLE_FILE_MAP_WRITE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Step 2c: File data change (RF10) -> trigger Candidate
			{
				"eventType": "LLE_FILE_DATA_CHANGE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Step 2d: File rename -> trigger Candidate
			{
				"eventType": "LLE_FILE_RENAME",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Step 2e: File delete (RF4) -> trigger Candidate
			{
				"eventType": "LLE_FILE_DELETE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Step 3: Count the distinct candidate hits per process and forward to evaluation
			{
				"eventType": "MLE_RANSOM_CANDIDATE",
				"rule": {
					"loadContext": {
						"basket": "@const.ransomBasket.processCounter",
						"key": "@event.process.id"
					},
					"saveContext": {
						"basket": "@const.ransomBasket.processCounter",
						"key": "@event.process.id",
						"lifetime": 86400000,
						"data": {
							"hitCount": {
								"$operation": "add",
								"args": [
									"@context.hitCount",
									1
								]
							}
						}
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_EVALUATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "destination", "value": "@event.destination" },
							{ "name": "source", "value": "@event.source" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "hitCount", "value": { "$operation": "add", "args": [ "@context.hitCount", 1 ] } }
						]
					}
				}
			},


  			// Step 4a: Fast Lane evaluation (User Profile files -> 2 hits) - abstractPath variant
  			{
  				"eventType": "MLE_RANSOM_EVALUATE",
  				"rule": {
  					"condition": {
  						"$operation": "and",
  						"args": [
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.process.imageFile.abstractPath" ]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.destination.abstractPath" ]
  							},
  							{
  								"$operation": "greater",
  								"args": [ "@event.hitCount", 1 ]
  							},
  							{
  								"$operation": "or",
  								"args": [
  									{
  										"$operation": "imatch",
  										"pattern": "*\\users\\*",
  										"args": [ "@event.destination.abstractPath" ]
  									},
  									{
  										"$operation": "imatch",
  										"pattern": "*\\users\\*",
  										"args": [ "@event.destination.rawPath" ]
  									}
  								]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "*\\appdata\\*",
  								"args": [ "@event.destination.abstractPath" ]
  							},
  							{
  								"$operation": "imatch",
  								"pattern": "?*",
  								"args": [ "@event.process.imageFile.abstractPath" ]
  							}
  						]
  					},
  					"createEvent": {
  						"eventType": "MLE_RANSOM_BEHAVIOR",
  						"destination": "OUT",
  						"clone": false,
  						"data": [
  							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
  							{ "name": "process", "value": "@event.process" },
  							{ "name": "destination", "value": "@event.destination" },
  							{ "name": "source", "value": "@event.source" },
  							{ "name": "time", "value": "@event.time" },
  							{ "name": "tickTime", "value": "@event.tickTime" },
  							{ "name": "hitCount", "value": "@event.hitCount" },
  							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
  						]
  					}
  				}
  			},

  			// Step 4a (fallback): Fast Lane evaluation - rawPath variant
  			{
  				"eventType": "MLE_RANSOM_EVALUATE",
  				"rule": {
  					"condition": {
  						"$operation": "and",
  						"args": [
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.process.imageFile.rawPath" ]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.destination.rawPath" ]
  							},
  							{
  								"$operation": "greater",
  								"args": [ "@event.hitCount", 1 ]
  							},
  							{
  								"$operation": "or",
  								"args": [
  									{
  										"$operation": "imatch",
  										"pattern": "*\\users\\*",
  										"args": [ "@event.destination.abstractPath" ]
  									},
  									{
  										"$operation": "imatch",
  										"pattern": "*\\users\\*",
  										"args": [ "@event.destination.rawPath" ]
  									}
  								]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "*\\appdata\\*",
  								"args": [ "@event.destination.rawPath" ]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "?*",
  								"args": [ "@event.process.imageFile.abstractPath" ]
  							}
  						]
  					},
  					"createEvent": {
  						"eventType": "MLE_RANSOM_BEHAVIOR",
  						"destination": "OUT",
  						"clone": false,
  						"data": [
  							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
  							{ "name": "process", "value": "@event.process" },
  							{ "name": "destination", "value": "@event.destination" },
  							{ "name": "source", "value": "@event.source" },
  							{ "name": "time", "value": "@event.time" },
  							{ "name": "tickTime", "value": "@event.tickTime" },
  							{ "name": "hitCount", "value": "@event.hitCount" },
  							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
  						]
  					}
  				}
  			},

  			// Step 4b: Slow Lane evaluation (Non-User Profile files -> 5 hits) - abstractPath variant
  			{
  				"eventType": "MLE_RANSOM_EVALUATE",
  				"rule": {
  					"condition": {
  						"$operation": "and",
  						"args": [
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.process.imageFile.abstractPath" ]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.destination.abstractPath" ]
  							},
  							{
  								"$operation": "greater",
  								"args": [ "@event.hitCount", 4 ]
  							},
  							{
  								"$operation": "or",
  								"args": [
  									{
  										"$operation": "!imatch",
  										"pattern": "*\\users\\*",
  										"args": [ "@event.destination.abstractPath" ]
  									},
  									{
  										"$operation": "imatch",
  										"pattern": "*\\appdata\\*",
  										"args": [ "@event.destination.abstractPath" ]
  									}
  								]
  							},
  							{
  								"$operation": "imatch",
  								"pattern": "?*",
  								"args": [ "@event.process.imageFile.abstractPath" ]
  							}
  						]
  					},
  					"createEvent": {
  						"eventType": "MLE_RANSOM_BEHAVIOR",
  						"destination": "OUT",
  						"clone": false,
  						"data": [
  							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
  							{ "name": "process", "value": "@event.process" },
  							{ "name": "destination", "value": "@event.destination" },
  							{ "name": "source", "value": "@event.source" },
  							{ "name": "time", "value": "@event.time" },
  							{ "name": "tickTime", "value": "@event.tickTime" },
  							{ "name": "hitCount", "value": "@event.hitCount" },
  							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
  						]
  					}
  				}
  			},

  			// Step 4b (fallback): Slow Lane evaluation - rawPath variant
  			{
  				"eventType": "MLE_RANSOM_EVALUATE",
  				"rule": {
  					"condition": {
  						"$operation": "and",
  						"args": [
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.process.imageFile.rawPath" ]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "@const.ransomSystemExclusions",
  								"args": [ "@event.destination.rawPath" ]
  							},
  							{
  								"$operation": "greater",
  								"args": [ "@event.hitCount", 4 ]
  							},
  							{
  								"$operation": "or",
  								"args": [
  									{
  										"$operation": "!imatch",
  										"pattern": "*\\users\\*",
  										"args": [ "@event.destination.rawPath" ]
  									},
  									{
  										"$operation": "imatch",
  										"pattern": "*\\appdata\\*",
  										"args": [ "@event.destination.rawPath" ]
  									}
  								]
  							},
  							{
  								"$operation": "!imatch",
  								"pattern": "?*",
  								"args": [ "@event.process.imageFile.abstractPath" ]
  							}
  						]
  					},
  					"createEvent": {
  						"eventType": "MLE_RANSOM_BEHAVIOR",
  						"destination": "OUT",
  						"clone": false,
  						"data": [
  							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
  							{ "name": "process", "value": "@event.process" },
  							{ "name": "destination", "value": "@event.destination" },
  							{ "name": "source", "value": "@event.source" },
  							{ "name": "time", "value": "@event.time" },
  							{ "name": "tickTime", "value": "@event.tickTime" },
  							{ "name": "hitCount", "value": "@event.hitCount" },
  							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
  						]
  					}
  				}
  			},

			// Step 5: Cleanup context when process exits
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.ransomBasket.readWrite",
						"group": "@event.process.id"
					}
				}
			}
		], // RANSOM_BEHAVIOR

		//
		// Pattern for cloud FLS malicious verdict
		//
		"FLS_MALICIOUS_VERDICT": [
			// Case 1: file.verdict is 2 (MALWARE), abstractPath is available
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.file.verdict", 2 ]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.abstractPath" }
						]
					}
				}
			},
			// Case 2: file.verdict is 2 (MALWARE), abstractPath is missing -> use rawPath
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.file.verdict", 2 ]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.rawPath" }
						]
					}
				}
			},
			// Case 3: process.imageFile.verdict is 2 (MALWARE), abstractPath is available
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.process.imageFile.verdict", 2 ]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},
			// Case 4: process.imageFile.verdict is 2 (MALWARE), abstractPath is missing -> use rawPath
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.process.imageFile.verdict", 2 ]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			}
		] // FLS_MALICIOUS_VERDICT
	}
}

