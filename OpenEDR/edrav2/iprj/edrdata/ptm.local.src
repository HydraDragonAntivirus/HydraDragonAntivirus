			"eventType": "LLE_REGISTRY_VALUE_SET",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*\\microsoft\\windows\\currentversion\\policies\\system\\promptonsecuredesktop*",
								"args": [ "@event.registry.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\microsoft\\windows\\currentversion\\policies\\system\\promptonsecuredesktop*",
								"args": [ "@event.registry.rawPath" ]
							}
						]
					},
							{
								"$operation": "imatch",
								"pattern": "0",
								"args": [ "@event.registry.data" ]
							}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_REGISTRY",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_REGISTRY" },
						{ "name": "process", "value": "@event.process" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "should_trust_company_whitelist", "value": true },
						{ "name": "should_trust_comodo_fls_cloud", "value": true }
					]
				}
			}
		},
