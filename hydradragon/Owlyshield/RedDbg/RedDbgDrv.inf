;
; RedDbgDrv.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer = 05/20/2026,12.27.56.333
CatalogFile=RedDbgDrv.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
DriverFiles = 12
DriverFiles.Del = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
RedDbgDrv.sys = 1,,

[DefaultInstall.ntamd64]
OptionDesc = %RedDbg.DeviceDesc%
CopyFiles = DriverFiles

[DefaultInstall.ntamd64.Services]
AddService = RedDbg,%SPSVCINST_ASSOCSERVICE%,RedDbg_Service_Inst

[DefaultUninstall.ntamd64]
LegacyUninstall = 1
DelFiles = DriverFiles.Del

[DefaultUninstall.ntamd64.Services]
DelService = RedDbg,0x200

[DriverFiles]
RedDbgDrv.sys

[DriverFiles.Del]
RedDbgDrv.sys

[RedDbg_Service_Inst]
DisplayName   = %RedDbg.SVCDESC%
Description   = %RedDbg.SVCDESC%
ServiceType   = 1
StartType     = 2
ErrorControl  = 1
ServiceBinary = %12%\RedDbgDrv.sys

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
ManufacturerName="HydraDragon"
DiskName="RedDbg Installation Disk"
RedDbg.DeviceDesc="RedDbg Kernel Driver"
RedDbg.SVCDESC="RedDbg Kernel Debugger Service"
