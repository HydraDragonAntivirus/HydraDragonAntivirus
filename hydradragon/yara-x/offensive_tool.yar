rule malware {
  meta:
    description   = "Detection patterns for the tool 'malware' taken from the ThreatHunting-Keywords github project"
    author        = "@mthcht"
    reference     = "https://github.com/mthcht/ThreatHunting-Keywords"
    tool          = "malware"
    rule_category = "offensive_tool_keyword"

  strings:
    // Description: Destructive Malware targeting organizations
    // Reference: https://www.microsoft.com/security/blog/2022/01/15/destructive-malware-targeting-ukrainian-organizations/
    $string1 = /\s\>\s\\\\127\.0\.0\.1\\ADMIN\$\\__.*\s2\>\&1/ nocase ascii wide
    // Description: Destructive Malware targeting organizations
    // Reference: https://www.microsoft.com/security/blog/2022/01/15/destructive-malware-targeting-ukrainian-organizations/
    $string2 = /cmd\.exe\s\/Q\s\/c\sstart\s.*stage1\.exe\s1/ nocase ascii wide
    // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
    // Reference: N/A
    $string3 = /del\s.*C:\\Program\sFiles.*\\TeamViewer\\TeamViewer.*_Logfile\.log/ nocase ascii wide
    // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
    // Reference: N/A
    $string4 = /del\s.*C:\\Users\\.*\\AppData\\Roaming\\AnyDesk\\connection_trace\.txt/ nocase ascii wide
    // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
    // Reference: N/A
    $string5 = /Remove\-Item\s.*C:\\Program\sFiles.*\\TeamViewer\\TeamViewer.*_Logfile\.log/ nocase ascii wide
    // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
    // Reference: N/A
    $string6 = /Remove\-Item\s.*C:\\Users\\.*\\AppData\\Roaming\\AnyDesk\\connection_trace\.txt/ nocase ascii wide

  condition:
    any of them
}

