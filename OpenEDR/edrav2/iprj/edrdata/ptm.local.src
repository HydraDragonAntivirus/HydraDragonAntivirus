			// SIGMA 802477a9-01ea-d5f8-2ff9-44285787d0f7 [high] PowerShell Web Access Installation - PsScript
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*install-windowsfeature windowspowershellwebaccess*",
								"args": [ "@event.childProcess.scriptContent" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*install-pswawebapplication*",
								"args": [ "@event.childProcess.scriptContent" ]
							},
							{
						"$operation": "and",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*add-pswaauthorizationrule*",
								"args": [ "@event.childProcess.scriptContent" ]
							},
							{
								"$operation": "imatch",
								"pattern": "-username *",
								"args": [ "@event.childProcess.scriptContent" ]
							},
							{
								"$operation": "imatch",
								"pattern": "-computername *",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_SCRIPT",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_SCRIPT" },
						{ "name": "process", "value": "@event.childProcess" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "quarantineTarget", "value": "@event.childProcess.imagePath" },
						{ "name": "should_trust_company_whitelist", "value": false },
						{ "name": "should_trust_comodo_fls_cloud", "value": false }
					]
				}
			}
		},
