#define CMD_RC_FILE_DESCRIPTION_STR CMD_RC_PRODUCT_NAME_STR " service"

#include "libcore\inc\resource_base.rc"

//
// Icon
//
// Explicit numeric ID so the C++ code (mode_start.cpp) can reference the
// application icon via MAKEINTRESOURCEW(IDI_MAIN). Without an explicit value the
// resource compiler assigns one that is invisible to the C++ compiler.
#define IDI_MAIN 101
IDI_MAIN                ICON                    "edrsvc.ico"
