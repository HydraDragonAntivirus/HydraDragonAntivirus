//
// Local policy definition for PatternsMatching
//
{
	"version": 2,
	"name": "ptmLocal",
	"group": "patternsMatching",
	"dependencies": [ "common" ],

	"constants": {
		"basket": {
			"fileReadWrite": "FILE_COPY_READ_WRITE",
			"fileWriteRead": "FILE_COPY_WRITE_READ"
		},
		"ransomShadowEventBaseType": {
			"MLE_RANSOM_SHADOW_COPY_DELETE": 1000009
		},
		"ransomShadowDeleteCmdLines": [
			"*vssadmin*delete shadows*",
			"*wmic*shadowcopy delete*",
			"*wmic*shadowcopy*delete*",
			"*wbadmin*delete catalog*",
			"*bcdedit*recoveryenabled*no*",
			"*wbadmin*delete systemstatebackup*",
			"*vssadmin*resize shadowstorage*"
		],
		"ransomEventBaseType": {
			"MLE_RANSOM_BEHAVIOR": 1000008
		},
		"ransomBehaviorEventBaseType": {
			"MLE_RANSOM_BEHAVIOR": 1000008
		},
		"ransomBasket": {
			"readWrite": "RANSOM_FILE_READ_WRITE",
			"processCounter": "RANSOM_PROCESS_COUNTER"
		},
		// Crypto-API basket for mass-usage detection (owlyHook telemetry)
		"cryptoBasket": {
			"mass": "CRYPTO_API_MASS"
		},
		// Canonical crypto APIs (advapi32 / bcrypt / ncrypt / ntdll) reported by
		// owlyHook. Used as the scope for the distinct-counter so only real crypto
		// APIs are counted (not arbitrary hooked functions).
		"cryptoApiList": [
			"advapi32.dll!CryptAcquireContextA",
			"bcrypt.dll!BCryptOpenAlgorithmProvider",
			"ncrypt.dll!NCryptEncrypt",
			"advapi32.dll!CryptGenKey",
			"bcrypt.dll!BCryptGenerateKeyPair",
			"ncrypt.dll!NCryptImportKey",
			"advapi32.dll!CryptEncrypt",
			"bcrypt.dll!BCryptEncrypt",
			"ncrypt.dll!NCryptCreatePersistedKey",
			"advapi32.dll!CryptHashData",
			"bcrypt.dll!BCryptImportKey",
			"ncrypt.dll!NCryptExportKey",
			"advapi32.dll!CryptExportKey",
			"bcrypt.dll!BCryptDeriveKey",
			"ncrypt.dll!NCryptSignHash",
			"advapi32.dll!CryptAcquireContextW",
			"bcrypt.dll!BCryptFinalizeKeyPair",
			"ncrypt.dll!NCryptSecretAgreement",
			"advapi32.dll!CryptImportKey",
			"bcrypt.dll!BCryptGenerateSymmetricKey",
			"ncrypt.dll!NCryptDeriveKey",
			"advapi32.dll!CryptCreateHash",
			"bcrypt.dll!BCryptCloseAlgorithmProvider",
			"ncrypt.dll!NCryptFinalizeKey",
			"advapi32.dll!CryptSetKeyParam",
			"bcrypt.dll!BCryptImportKeyPair",
			"advapi32.dll!CryptDeriveKey",
			"bcrypt.dll!BCryptExportKey",
			"advapi32.dll!CryptGetKeyParam",
			"bcrypt.dll!BCryptSetProperty",
			"advapi32.dll!CryptGetHashParam",
			"bcrypt.dll!BCryptSecretAgreement",
			"advapi32.dll!SystemFunction036",
			"ntdll.dll!RtlEncryptMemory"
		],
		// Extensions of user files whose encryption is treated as ransomware-relevant.
		// Scopes the file-encryption candidate so extensionless / temp files do not FP.
		"ransomFileExtensions": [
			"*.0",
			"*.0nv",
			"*.0rv",
			"*.1",
			"*.10",
			"*.10-config",
			"*.100",
