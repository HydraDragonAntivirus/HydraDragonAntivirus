private rule comrat {
  meta:
    author    = "Symantec"
    malware   = "COMRAT"
    Reference = "https://www.symantec.com/content/en/us/enterprise/media/security_response/whitepapers/waterbug-attack-group.pdf"

  strings:
    $b = { C6 45 ?? ?? }
    $c = { C6 85 ?? FE FF FF ?? }
    //$d = {FFA0??0?0000}
    $e = { 89 A8 ?? 00 00 00 68 ?? 00 00 00 56 FF D7 8B }
    $f = { 00 00 48 89 ?? ?? 03 00 00 48 8B }

  condition:
    IsPeFile and ((#c > 200 and #b > 200)  /*or (#d > 40)*/ and (#e > 15 or #f > 30))
}

