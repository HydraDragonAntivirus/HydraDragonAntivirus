  // b8b80e9458ff0276c9a37f5b46646936a08b83ce050a14efb93350f47aa7d269
  // 079be05edcd5793e1e3596cdb5f511324d0bcaf50eb47119236d3cb8defdfa4c

  condition:
    filesize < 3000KB
    and $header_docf at 0
    and $s1
