			// SIGMA 8b15d432-7c88-1622-8af2-9ab6b7134bdf [medium] Add Debugger Entry To AeDebug For Persistence
		{
			"eventType": "LLE_REGISTRY_KEY_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*\\software\\microsoft\\windows nt\\currentversion\\aedebug\\debugger*",
								"args": [ "@event.registry.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\software\\microsoft\\windows nt\\currentversion\\aedebug\\debugger*",
								"args": [ "@event.registry.rawPath" ]
							}
						]
					},
							{
								"$operation": "imatch",
								"pattern": "*.dll",
								"args": [ "@event.registry.data" ]
