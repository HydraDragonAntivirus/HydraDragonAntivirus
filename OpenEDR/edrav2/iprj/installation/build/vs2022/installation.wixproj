<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <Platforms>x86;x64</Platforms>
    <ProjectGuid>6c957042-f2be-441c-9cd7-589f51f0d842</ProjectGuid>
    <OutputName>installation</OutputName>
    <OutputType>Package</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VerboseOutput>true</VerboseOutput>
    <HarvestDirectoryGenerateGuidsNow>true</HarvestDirectoryGenerateGuidsNow>
    <HarvestDirectorySuppressFragments>true</HarvestDirectorySuppressFragments>
    <HarvestDirectorySuppressRegistry>true</HarvestDirectorySuppressRegistry>
    <HarvestDirectorySuppressRootDirectory>true</HarvestDirectorySuppressRootDirectory>
	<AcceptEula>wix6</AcceptEula>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformName Condition=" '$(Platform)' == 'x86' ">Win32</PlatformName>
    <PlatformName Condition=" '$(Platform)' == 'x64' ">x64</PlatformName>
  </PropertyGroup>

  <Import Project="..\..\..\build\vs2022\consts.props" />

  <PropertyGroup>
    <OutputPath>$(CmdRootDir)\out\install\$(CmdOutDirName)\</OutputPath>
    <IntermediateOutputPath>$(CmdRootDir)\out\temp\$(CmdOutDirName)\$(OutputName)\</IntermediateOutputPath>
    <DefineConstants>BIN_PATH=$(CmdRootDir)\out\bin\;OUT_DIR_NAME=$(CmdOutDirName)\;SourceBinDir=$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\</DefineConstants>
    <IncludeSearchPaths>..\..\src</IncludeSearchPaths>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Product.wxs">
      <Link>Product.wxs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Define.wxi">
      <Link>Define.wxi</Link>
    </Content>
    <Content Include="..\..\src\BuildInfo.wxi">
      <Link>BuildInfo.wxi</Link>
    </Content>
    <Content Include="..\..\src\InstallSequence.wxi">
      <Link>InstallSequence.wxi</Link>
    </Content>
    <Content Include="..\..\src\util.js">
      <Link>util.js</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="..\..\src" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2" />
  </ItemGroup>

  <Target Name="ValidateSourceBinaries" BeforeTargets="PrepareInstallationPayload">
    <Warning Condition="!Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Text="Source binaries not found in '$(CmdRootDir)\out\bin\$(CmdOutDirName)'. The installer will be empty." />
  </Target>

  <Target Name="PrepareInstallationPayload" BeforeTargets="CoreCompile">
    <Exec Command='if exist "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)" rd "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)" /S /Q' />
    <Exec Command='md "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)"' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command='xcopy "$(CmdRootDir)\out\bin\$(CmdOutDirName)" "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)" /Q /E /I /Exclude:$(ProjectDir)..\..\src\exclude.list' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command='FOR /r "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)" %%i in (*.cfg, *.qsc, *.src, *.act) do "$(CmdRootDir)\out\bin\$(CmdOutDirName)\edrcon.exe" file encrypt -f "%%~i" -o "%%~i.new" -e aes' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command='FOR /r "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)" %%i in (*evm.cloud.src, *evm.local.src) do copy "%%~i" "%%~i.new" /Y' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\$(CmdOutDirName)')" Command='FOR /r "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)" %%i in (*.new) do del "%%~dpni" /F /Q &amp; ren "%%~i" "%%~ni"' />
    <Exec Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\WinDivert\WinDivert.dll" "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\"' />
    <Exec Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\WinDivert\WinDivert64.sys" "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\"' />
    <Exec Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\owlyshield_predict\target\release\owlyshield_ransom.dll" "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\"' />
    <Exec Command='xcopy /Y /D /E /I "$(ProjectDir)..\..\..\..\rules" "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\rules\"' />
    <Exec Command='xcopy /Y /D /E /I "$(ProjectDir)..\..\..\..\firewall-rules" "$(CmdRootDir)\out\srcBinInstall\$(CmdOutDirName)\firewall-rules\"' />
  </Target>
</Project>
