			// SIGMA ae7a6aa8-b9bd-4f34-f72a-5e9d33e9098c [high] NtdllPipe Like Activity Execution
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "or",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*type %windir%\\system32\\ntdll.dll*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*type %windir%\\system32\\ntdll.dll*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*type %systemroot%\\system32\\ntdll.dll*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*type %systemroot%\\system32\\ntdll.dll*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*type c:\\windows\\system32\\ntdll.dll*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*type c:\\windows\\system32\\ntdll.dll*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*\\\\ntdll.dll > \\\\\\\\.\\\\pipe\\\\*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\\\ntdll.dll > \\\\\\\\.\\\\pipe\\\\*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_PROCESS",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_PROCESS" },
						{ "name": "process", "value": "@event.childProcess" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "quarantineTarget", "value": "@event.childProcess.imagePath" },
						{ "name": "should_trust_company_whitelist", "value": false },
						{ "name": "should_trust_comodo_fls_cloud", "value": false }
					]
				}
			}
		},
