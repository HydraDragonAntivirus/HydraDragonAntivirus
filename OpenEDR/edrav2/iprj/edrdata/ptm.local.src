		"pswBasket": {
			"pswCredRead": "PSW_CRED_READ",
			"pswReadFiles": "PSW_READ_FILES",
			"pswWriteAfterRead": "PSW_WRITE_AFTER_READ"
		},
		// Credential / browser data paths (imatch is case-insensitive)
		"pswCredPaths": [
			"*\\Google\\Chrome\\User Data*",
			"*\\Microsoft\\Edge\\User Data*",
			"*\\BraveSoftware\\Brave-Browser\\User Data*",
			"*\\Opera Software\\Opera Stable*",
			"*\\Opera Software\\Opera GX Stable*",
			"*\\Discord\\Local Storage*",
			"*\\Discord\\leveldb*",
			"*Electrum\\wallets*",
			"*Bitcoin\\wallets*",
			"*Ethereum\\keystore*",
			"*Cookies*",
			"*Login Data*",
			"*Web Data*",
			"*Local State*"
		],
		// System and browser cache paths excluded from ransomware tripping (FP reduction)
		"ransomSystemExclusions": [
			"*\\Windows\\*",
			"*\\Program Files\\*",
			"*\\Program Files (x86)\\*",
			"*\\ProgramData\\*",
			"*\\AppData\\*",
			"*\\Temp\\*",
			"*:Zone.Identifier*"
		],
		"tokenTheftEventBaseType": {
			"MLE_TOKEN_THEFT_ATTEMPT": 1000013,
			"MLE_PROCESS_INJECTION_TAMPERING": 1000014
		},
		"securitySubsystemProcesses": [
			"*\\winlogon.exe*",
			"*\\lsass.exe*",
			"*\\csrss.exe*",
			"*\\services.exe*",
			"*\\sanctum_ppl_runner.exe*"
		],
		"trustedSecurityCallers": [
			"*\\Windows\\System32\\*",
			"*\\Windows\\SysWOW64\\*",
			"*\\Windows\\WinSxS\\*",
			"*\\Program Files\\HydraDragonAntivirus\\*",
			// VM guest agents - legitimate OS integration, suppress token theft FPs
			"*\\VMware\\VMware Tools\\vmtoolsd.exe*",
			"*\\VMware\\VMware Tools\\VMwareResolutionSet.exe*",
			"*\\VMware\\VMware Tools\\vmacthlp.exe*",
			"*\\Oracle\\VirtualBox Guest Additions\\VBoxService.exe*",
			"*\\Oracle\\VirtualBox Guest Additions\\VBoxTray.exe*",
			"*\\Parallels\\Parallels Tools\\prl_tools.exe*",
			"*\\Parallels\\Parallels Tools\\prl_cc.exe*"
