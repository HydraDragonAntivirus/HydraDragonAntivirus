<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64</Platforms>
    <ProjectGuid>{b7302b2d-5ee2-4660-a1c8-a8d560d9c581}</ProjectGuid>
    <OutputName>upgrade</OutputName>
    <OutputType>Package</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VerboseOutput>true</VerboseOutput>
    <HarvestDirectoryGenerateGuidsNow>true</HarvestDirectoryGenerateGuidsNow>
    <HarvestDirectorySuppressFragments>true</HarvestDirectorySuppressFragments>
    <HarvestDirectorySuppressRegistry>true</HarvestDirectorySuppressRegistry>
    <HarvestDirectorySuppressRootDirectory>true</HarvestDirectorySuppressRootDirectory>
	<AcceptEula>wix6</AcceptEula>
	<SuppressValidation>true</SuppressValidation>
	<SuppressIces>ICE61;ICE03;ICE80;ICE38;ICE60</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformName Condition=" '$(Platform)' == 'x64' ">x64</PlatformName>
  </PropertyGroup>

  <Import Project="..\..\..\build\vs2022\consts.props" />

  <PropertyGroup>
    <OutputPath>$(CmdRootDir)\out\upgrade\$(CmdOutDirName)\</OutputPath>
    <IntermediateOutputPath>$(CmdRootDir)\out\temp\$(CmdOutDirName)\$(OutputName)\</IntermediateOutputPath>
    <DefineConstants>BIN_PATH=$(CmdRootDir)\out\bin\;OUT_DIR_NAME=$(CmdOutDirName)\;SourceBinDir64=$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\</DefineConstants>
    <IncludeSearchPaths>..\..\src;..\..\..\installation\src</IncludeSearchPaths>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <SuppressValidation>true</SuppressValidation>
    <SuppressIces>ICE61;ICE03;ICE80;ICE38;ICE60</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Product.wxs">
      <Link>Product.wxs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\installation\src\Define.wxi">
      <Link>Define.wxi</Link>
    </Content>
    <Content Include="..\..\..\installation\src\BuildInfo.wxi">
      <Link>BuildInfo.wxi</Link>
    </Content>
    <Content Include="..\..\..\installation\src\InstallSequence.wxi">
      <Link>InstallSequence.wxi</Link>
    </Content>
    <Content Include="..\..\..\installation\src\util.js">
      <Link>util.js</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="..\..\src" />
    <BindPath Include="..\..\..\installation\src" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2" />
  </ItemGroup>

  <Target Name="ValidateSourceBinaries" BeforeTargets="PrepareUpgradePayload">
    <Warning Condition="!Exists('$(CmdRootDir)\out\bin\win-$(Configuration)-x64')" Text="Source binaries not found in '$(CmdRootDir)\out\bin\win-$(Configuration)-x64'. The x64 part of the installer will be empty." />
  </Target>

  <Target Name="PrepareUpgradePayload" BeforeTargets="CoreCompile">
    <Exec Command='if exist "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)" rd "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)" /S /Q' />
    <Exec Command='md "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64"' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\win-$(Configuration)-x64')" Command='xcopy "$(CmdRootDir)\out\bin\win-$(Configuration)-x64" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64" /Q /E /I /Exclude:$(ProjectDir)..\..\..\installation\src\exclude.list' />
    <Exec Command='xcopy /Y /D /E /I "$(ProjectDir)..\..\..\..\firewall-rules" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\firewall-rules\"' />
    <Exec Command='xcopy /Y /D /E /I "$(ProjectDir)..\..\..\..\..\owlyshield_predict\models" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\models\"' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\win-$(Configuration)-x64') AND Exists('$(CmdRootDir)\out\bin\win-$(Configuration)-x64\edrcon.exe')" Command='FOR /r "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64" %%i in (*.cfg, *.qsc, *.src) do "$(CmdRootDir)\out\bin\win-$(Configuration)-x64\edrcon.exe" file encrypt -f "%%~i" -o "%%~i.new" -e aes' />
    <Exec Condition="Exists('$(CmdRootDir)\out\bin\win-$(Configuration)-x64') AND Exists('$(CmdRootDir)\out\bin\win-$(Configuration)-x64\edrcon.exe')" Command='FOR /r "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64" %%i in (*.new) do del "%%~dpni" /F /Q &amp; ren "%%~i" "%%~ni"' />


    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\um_engine.exe')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\um_engine.exe" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\elam_installer.exe')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\elam_installer.exe" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum_ppl_runner.exe')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum_ppl_runner.exe" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\AppData\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\server.exe')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\server.exe" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\System32\sanctum.dll" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\System32\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\"' />
    <Exec Condition="Exists('$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys')" Command='xcopy /Y /D "$(ProjectDir)..\..\..\..\..\..\hydradragon\Sanctum\AppData\sanctum.sys" "$(CmdRootDir)\out\srcBinUpgrade\$(CmdOutDirName)\x64\Sanctum\AppData\"' />
  </Target>
</Project>
