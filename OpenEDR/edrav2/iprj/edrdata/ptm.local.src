			// SIGMA 49da8649-c56c-f962-aade-f62bb1cd465c [medium] Hidden Powershell in Link File Pattern
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*powershell*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*powershell*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*.lnk*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*.lnk*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "c:\\windows\\explorer.exe",
								"args": [ "@event.process.imageFile.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "c:\\windows\\explorer.exe",
								"args": [ "@event.process.imageFile.rawPath" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "c:\\windows\\system32\\cmd.exe",
								"args": [ "@event.childProcess.imagePath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "c:\\windows\\system32\\cmd.exe",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "c:\\windows\\system32\\cmd.exe",
								"args": [ "@event.childProcess.imageFile.rawPath" ]
							}
						]
					}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_PROCESS",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_PROCESS" },
						{ "name": "process", "value": "@event.childProcess" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "should_trust_company_whitelist", "value": true },
						{ "name": "should_trust_comodo_fls_cloud", "value": true }
					]
				}
			}
		},
