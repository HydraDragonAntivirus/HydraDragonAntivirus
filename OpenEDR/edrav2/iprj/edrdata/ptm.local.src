			// SIGMA ff580d50-30ff-1e98-ec8c-c70512d70b55 [medium] Folder Compress To Potentially Suspicious Output Via Compress-Archive Cmdlet
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "or",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "compress-archive -path*-destinationpath $env:temp",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "compress-archive -path*-destinationpath $env:temp",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "compress-archive -path*-destinationpath*\\appdata\\local\\temp\\",
								"args": [ "@event.childProcess.cmdLine" ]
