			// SIGMA a1e4b72a-2af2-0002-fb44-971730e2befa [medium] Disable Exploit Guard Network Protection on Windows Defender
		{
			"eventType": "LLE_REGISTRY_KEY_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*software\\policies\\microsoft\\windows defender security center\\app and browser protection\\disallowexploitprotectionoverride*",
								"args": [ "@event.registry.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*software\\policies\\microsoft\\windows defender security center\\app and browser protection\\disallowexploitprotectionoverride*",
								"args": [ "@event.registry.rawPath" ]
							}
						]
					},
							{
								"$operation": "imatch",
								"pattern": "dword (00000001)",
								"args": [ "@event.registry.data" ]
							}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_REGISTRY",
					"destination": "OUT",
					"clone": false,
					"data": [
