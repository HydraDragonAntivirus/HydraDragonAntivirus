//
// Local policy definition for PatternsMatching
//
{
	"version": 2,
	"name": "ptmLocal",
	"group": "patternsMatching",
	"dependencies": [ "common" ],

	"constants": {
		"basket": {
			"fileReadWrite": "FILE_COPY_READ_WRITE",
			"fileWriteRead": "FILE_COPY_WRITE_READ",
			"ransomReadFiles": "RANSOM_READ_FILES",
			"ransomWriteAfterRead": "RANSOM_WRITE_AFTER_READ"
		},
		"ransomEventBaseType": {
			"MLE_RANSOMWARE_FILE_ENCRYPTION": 1000008,
			"MLE_RANSOM_SHADOW_COPY_DELETE": 1000009
		},
		// imatch (case-insensitive wildcard) patterns for shadow-copy wiping
		"ransomShadowDeleteCmdLines": [
			"*vssadmin*delete shadows*",
			"*wmic*shadowcopy delete*",
			"*wmic*shadowcopy*delete*",
			"*wbadmin*delete catalog*"
		]
	},

	"variables": {
		"copyFileKey": [ "@event.process.id", "@event.file.rawHash" ],
		// Ransomware correlation is keyed by file identity (uniquePath), not
		// content hash: in-place encryption changes content, so the read and
		// write sequence hashes differ while the file stays the same.
		"ransomPathKey": [ "@event.process.id", "@event.file.uniquePath" ]
	},

	"patterns": {

		//
		// Pattern for copy-file READ-WRITE scenario
		//
		"FILE_COPY_READ_WRITE": [

			// Detect full read and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey"
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@event.file"
							},
							{
								"name": "source",
								"value": "@context.file"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							}
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileReadWrite",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_READ_WRITE

		//
		// Pattern for copy-file WRITE-READ scenario
		//
		"FILE_COPY_WRITE_READ": [

			// Detect full write and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"maxCopyCount": 100,
						"data": {
							"file": "@event.file",
							"time": "@event.time",
							"tickTime": "@event.tickTime"
						}
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"delete": true
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@context.file"
							},
							{
								"name": "source",
								"value": "@event.file"
							},
							{
								"name": "time",
								"value": "@context.time"
							},
							{
								"name": "tickTime",
								"value": "@context.tickTime"
							}
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileWriteRead",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_WRITE_READ

		//
		// Pattern for ransomware file-encryption scenario.
		// Purely behavioral: read -> modify same file -> remove/rename it.
		// Correlation is keyed by process + uniquePath (file identity), so
		// in-place encryption (content changes) still correlates. No extension
		// lists, no benign lists, no static hashes.
		//
		"RANSOMWARE_FILE_ENCRYPTION": [

			// 1) Full read of a file: remember it per process + file identity.
			//    Skip entirely for FLS-trusted (Comodo cloud verdict = Safe)
			//    processes so a signed/whitelisted process's normal
			//    read-modify-rewrite I/O (e.g. WebView2/Widgets cache churn)
			//    never enters the ransomware correlation chain.
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"condition": {
						"$operation": "notEqual",
						"args": [ "@event.process.flsVerdict", 1 ]
					},
					"saveContext": {
						"basket": "@const.basket.ransomReadFiles",
						"key": "@var.ransomPathKey",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 2) Full write to a previously-read file (same process):
			//    encrypt-and-save footprint
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.ransomReadFiles",
						"key": "@var.ransomPathKey"
					},
					"saveContext": {
						"basket": "@const.basket.ransomWriteAfterRead",
						"key": "@var.ransomPathKey",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 2b) Memory-mapped read: section-backed reads count as reads.
			//     Same FLS-trust gate as the full-read case above.
			{
				"eventType": "LLE_FILE_MAP_READ",
				"rule": {
					"condition": {
						"$operation": "notEqual",
						"args": [ "@event.process.flsVerdict", 1 ]
					},
					"saveContext": {
						"basket": "@const.basket.ransomReadFiles",
						"key": "@var.ransomPathKey",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 2c) Memory-mapped write to a previously-read file:
			//     encrypt-in-place footprint via section I/O
			{
				"eventType": "LLE_FILE_MAP_WRITE",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.ransomReadFiles",
						"key": "@var.ransomPathKey"
					},
					"saveContext": {
						"basket": "@const.basket.ransomWriteAfterRead",
						"key": "@var.ransomPathKey",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 3a) Delete of a written-after-read file = original removal
			//     after encryption -> detection
			{
				"eventType": "LLE_FILE_DELETE",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.ransomWriteAfterRead",
						"key": "@var.ransomPathKey",
						"delete": true
					},
					"createEvent": {
						"eventType": "MLE_RANSOMWARE_FILE_ENCRYPTION",
						"destination": "OUT",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.ransomEventBaseType.MLE_RANSOMWARE_FILE_ENCRYPTION"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "source",
								"value": "@context.file"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							}
						]
					}
				}
			},

			// 3b) Rename of a written-after-read file (extension-change /
			//     .locked style): the event's file identity is the ORIGINAL
			//     name; the new name rides on <fileRenameTarget>.
			{
				"eventType": "LLE_FILE_RENAME",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.ransomWriteAfterRead",
						"key": "@var.ransomPathKey",
						"delete": true
					},
					"createEvent": {
						"eventType": "MLE_RANSOMWARE_FILE_ENCRYPTION",
						"destination": "OUT",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.ransomEventBaseType.MLE_RANSOMWARE_FILE_ENCRYPTION"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "source",
								"value": "@context.file"
							},
							{
								"name": "destination",
								"value": "@event.fileRenameTarget"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							}
						]
					}
				}
			},

			// 4) Process termination: free ransomware-related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.ransomReadFiles",
						"group": "@event.process.id"
					}
				}
			},
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.ransomWriteAfterRead",
						"group": "@event.process.id"
					}
				}
			}
		], // RANSOMWARE_FILE_ENCRYPTION

		//
		// Pattern for shadow-copy deletion: vssadmin/wmic/wbadmin wiping
		// volume shadow copies is a near-zero-FP ransomware footprint.
		//
		"RANSOM_SHADOW_COPY_DELETE": [
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "@const.ransomShadowDeleteCmdLines",
						"args": [ "@event.process.cmdLine" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_SHADOW_COPY_DELETE",
						"destination": "OUT",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.ransomEventBaseType.MLE_RANSOM_SHADOW_COPY_DELETE"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							}
						]
					}
				}
			}
		] // RANSOM_SHADOW_COPY_DELETE
	}
}
