						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "registryDeleteTarget", "value": "@event.registry.abstractPath" },
						{ "name": "registryDeleteTargetRaw", "value": "@event.registry.rawPath" },
						{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" },
						{ "name": "should_trust_company_whitelist", "value": false },
						{ "name": "should_trust_comodo_fls_cloud", "value": false }
					]
				}
			}
		}
		]
,
		"GODMODE_MALICIOUS_ACTIVITY": [
			// Converted from inspired_rules/godmode_sigma_rule.yml (Florian Roth).
			// Doc3 (EventID 7045 service installs) skipped: no PTM service events.
			// Whoami rule is image-only: User field has no PTM equivalent.
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.godmodeCmdlines",
								"args": [ "@event.childProcess.cmdLine" ]
							},
