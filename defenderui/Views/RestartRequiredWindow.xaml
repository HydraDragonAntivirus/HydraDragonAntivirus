<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DefenderUI.Views.RestartRequiredWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HydraDragonAntivirus - Restart Required"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Border
        x:Name="RestartFrame"
        BorderThickness="3"
        BorderBrush="{ThemeResource StatusWarningBrush}"
        CornerRadius="12"
        Background="{ThemeResource SurfaceCardBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Üst marka barı -->
            <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="0"
                    Source="ms-appx:///Assets/AppLogo-32.png"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Column="1"
                    Text="HydraDragonAntivirus"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center" />

                <Border
                    Grid.Column="2"
                    CornerRadius="8"
                    Padding="8,3"
                    Background="{ThemeResource StatusWarningSoftBrush}">
                    <TextBlock
                        Text="RESTART REQUIRED"
                        Style="{StaticResource OverlineTextStyle}"
                        Foreground="{ThemeResource StatusWarningBrush}" />
                </Border>
            </Grid>

            <!-- Orta bölüm: açıklama -->
            <StackPanel Grid.Row="1" Padding="14,4,14,8" Spacing="6">
                <TextBlock
                    Text="A system restart is required to finish applying security changes."
                    Style="{StaticResource BodyMediumTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="HydraDragonAntivirus protection will be fully active after the restart."
                    Style="{StaticResource BodySmallTextStyle}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock
                    x:Name="FilePathText"
                    Text="{x:Bind FilePath}"
                    Style="{StaticResource BodySmallTextStyle}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    IsTextSelectionEnabled="True" />
            </StackPanel>

            <!-- Alt bölüm: butonlar -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="6"
                Padding="14,0,14,12">
                <Button
                    x:Name="LaterButton"
                    Content="Later"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="LaterButton_Click" />
                <Button
                    x:Name="RestartButton"
                    Content="Restart Now"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="RestartButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>