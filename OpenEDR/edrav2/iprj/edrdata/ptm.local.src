								"$operation": "imatch",
								"pattern": "*\\microsoft\\windows\\currentversion\\explorer\\runmru*",
								"args": [ "@event.registry.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\microsoft\\windows\\currentversion\\explorer\\runmru*",
								"args": [ "@event.registry.rawPath" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*powershell*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*pwsh*",
								"args": [ "@event.registry.data" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "* -e *",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "* -ec *",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "* -en *",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "* -enc *",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "* -enco*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*ftp*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*hidden*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*http*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*iex*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*invoke-*",
								"args": [ "@event.registry.data" ]
							}
						]
					}
						]
					},
							{
						"$operation": "and",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*wmic*",
								"args": [ "@event.registry.data" ]
							},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*shadowcopy*",
								"args": [ "@event.registry.data" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*process call create*",
								"args": [ "@event.registry.data" ]
							}
						]
					}
						]
					}
						]
					}
