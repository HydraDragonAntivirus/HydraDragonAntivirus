;
; RedDbgDrv.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=04/20/2026,0.18.1.0
CatalogFile=RedDbgDrv.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
Drivers_Dir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
RedDbgDrv.sys = 1,,

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%RedDbg.DeviceDesc%=RedDbg_Device, Root\RedDbg

[RedDbg_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
RedDbgDrv.sys

[RedDbg_Device.NT.Services]
AddService = RedDbg,%SPSVCINST_ASSOCSERVICE%,RedDbg_Service_Inst

[RedDbg_Service_Inst]
DisplayName   = %RedDbg.SVCDESC%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\RedDbgDrv.sys

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
ManufacturerName="HydraDragon"
DiskName="RedDbg Installation Disk"
RedDbg.DeviceDesc="RedDbg Kernel Driver"
RedDbg.SVCDESC="RedDbg Kernel Debugger Service"
