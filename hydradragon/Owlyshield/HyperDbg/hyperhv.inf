;
; hyperhv.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer = 04/20/2026,0.18.1.0
CatalogFile=hyperhv.cat

[DestinationDirs]
DefaultDestDir = 12
DriverFiles = 12
DriverFiles.Del = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
hyperhv.sys  = 1,,

[DefaultInstall.ntamd64]
OptionDesc = %hyperhv.DeviceDesc%
CopyFiles = DriverFiles

[DefaultInstall.ntamd64.Services]
AddService = hyperhv,%SPSVCINST_ASSOCSERVICE%,hyperhv_Service_Inst

[DefaultUninstall.ntamd64]
LegacyUninstall = 1
DelFiles = DriverFiles.Del

[DefaultUninstall.ntamd64.Services]
DelService = hyperhv,0x200

[DriverFiles]
hyperhv.sys

[DriverFiles.Del]
hyperhv.sys

[hyperhv_Service_Inst]
DisplayName    = %hyperhv.SVCDESC%
Description    = %hyperhv.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 2               ; SERVICE_AUTO_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\hyperhv.sys

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="HyperDbg"
DiskName = "hyperhv Installation Disk"
hyperhv.DeviceDesc = "HyperDbg Intel Hypervisor"
hyperhv.SVCDESC = "HyperDbg Hypervisor Service"
