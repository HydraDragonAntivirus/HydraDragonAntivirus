			// SIGMA 073e0fdf-35a4-362b-a1c6-2b1b41c71231 [high] Kalambur Backdoor Curl TOR SOCKS Proxy Execution
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*\\curl.exe",
								"args": [ "@event.childProcess.imagePath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\curl.exe",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\curl.exe",
								"args": [ "@event.childProcess.imageFile.rawPath" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*socks5h://*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*socks5h://*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*socks5://*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*socks5://*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*socks4a://*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*socks4a://*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*.onion*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*.onion*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_PROCESS",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_PROCESS" },
						{ "name": "process", "value": "@event.childProcess" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "quarantineTarget", "value": "@event.childProcess.imagePath" },
						{ "name": "should_trust_company_whitelist", "value": false },
						{ "name": "should_trust_comodo_fls_cloud", "value": false }
					]
				}
			}
		},
