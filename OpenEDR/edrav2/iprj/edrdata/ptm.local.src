		{
			"eventType": "LLE_REGISTRY_KEY_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*\\microsoft\\.netframework\\dbgmanageddebugger",
								"args": [ "@event.registry.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\microsoft\\.netframework\\dbgmanageddebugger",
								"args": [ "@event.registry.rawPath" ]
							}
						]
					},
							{
						"$operation": "not",
						"args": [
							{
								"$operation": "imatch",
