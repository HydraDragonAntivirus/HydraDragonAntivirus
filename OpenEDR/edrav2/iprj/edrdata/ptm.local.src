		"SIGMA_PROCESS": [
			// SIGMA d0fd7844-3a95-dea8-af80-626b8fcf4e3f [critical] ZxShell Malware
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "and",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*zxfunction*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*zxfunction*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*remotediskxxxxx*",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*remotediskxxxxx*",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "*\\rundll32.exe",
								"args": [ "@event.childProcess.imagePath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\rundll32.exe",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "*\\rundll32.exe",
								"args": [ "@event.childProcess.imageFile.rawPath" ]
							}
						]
					}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_PROCESS",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_PROCESS" },
						{ "name": "process", "value": "@event.childProcess" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "quarantineTarget", "value": "@event.childProcess.imagePath" },
						{ "name": "should_trust_company_whitelist", "value": false },
						{ "name": "should_trust_comodo_fls_cloud", "value": false }
					]
				}
			}
		},
			// SIGMA 43b8a8bc-fb6b-2385-d4a0-7efb8523c625 [critical] Turla Group Lateral Movement
		{
			"eventType": "LLE_PROCESS_CREATE",
			"rule": {
				"condition": {
						"$operation": "or",
						"args": [
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "net use \\\\\\\\%domaincontroller%\\c$ \"p@ssw0rd\" *",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "net use \\\\\\\\%domaincontroller%\\c$ \"p@ssw0rd\" *",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "dir c:\\\\*.doc* /s",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "dir c:\\\\*.doc* /s",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					},
							{
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "dir %temp%\\\\*.exe",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "dir %temp%\\\\*.exe",
								"args": [ "@event.childProcess.scriptContent" ]
							}
						]
					}
						]
					},
				"createEvent": {
					"eventType": "MLE_SIGMA_PROCESS",
					"destination": "OUT",
					"clone": false,
					"data": [
						{ "name": "baseType", "value": "@const.sigmaEventBaseType.MLE_SIGMA_PROCESS" },
						{ "name": "process", "value": "@event.childProcess" },
						{ "name": "processes", "value": "@event.processes" },
						{ "name": "time", "value": "@event.time" },
						{ "name": "tickTime", "value": "@event.tickTime" },
						{ "name": "quarantineTarget", "value": "@event.childProcess.imagePath" },
						{ "name": "should_trust_company_whitelist", "value": false },
						{ "name": "should_trust_comodo_fls_cloud", "value": false }
					]
				}
			}
		},
			// SIGMA a13f506e-fac9-0e14-f1b5-1cfbe9c57e46 [critical] Exploit for CVE-2015-1641
		{
			"eventType": "LLE_PROCESS_CREATE",
