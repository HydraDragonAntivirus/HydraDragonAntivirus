<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DefenderUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DefenderUI"
    xmlns:controls="using:DefenderUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="HydraDragonAntivirus"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            NOT: ToastHost overlay'i Grid'in en son child'ı olarak aşağıda
            tanımlıdır; böylece z-order olarak shell üzerinde kalır.
        -->

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="HydraDragonAntivirus - Koruma Aktif"
            Grid.Row="0">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Göster" Click="MenuShow_Click"/>
                    <MenuFlyoutItem Text="EDR'yi Başlat" Click="MenuEdrStart_Click"/>
                    <MenuFlyoutItem Text="EDR'yi Durdur" Click="MenuEdrStop_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Çıkış" Click="MenuExit_Click"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Custom Title Bar                                             -->
        <!-- Logo + HydraDragonAntivirus + StatusPill  |  spacer  | Theme -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid
            x:Name="AppTitleBarGrid"
            Grid.Row="0"
            Height="48"
            Padding="12,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- Windows System Caption Buttons (Min/Max/Close) için boşluk -->
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Logo + App Name -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Margin="4,0,0,0">
                <Image
                    Source="ms-appx:///Assets/AppLogo-32.png"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="HydraDragonAntivirus"
                    Style="{StaticResource TitleMediumTextStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status Pill -->
            <controls:StatusPill
                x:Name="HeaderStatusPill"
                Grid.Column="1"
                Severity="Protected"
                Text="Protected"
                Margin="16,0,0,0"
                VerticalAlignment="Center" />

            <!-- Spacer (draggable region, set via code-behind) -->
            <Border
                x:Name="TitleBarDragRegion"
                Grid.Column="2"
                Background="Transparent" />

            <!-- Right: Theme toggle + Notifications -->
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,4,0">
                <Button
                    x:Name="ThemeToggleButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="ThemeToggleButton_Click"
                    ToolTipService.ToolTip="Toggle theme"
                    AutomationProperties.Name="Toggle theme">
                    <FontIcon
                        x:Name="ThemeToggleIcon"
                        Glyph="&#xE706;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="16" />
                </Button>
                <Button
                    x:Name="NotificationsButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="NotificationsButton_Click"
                    ToolTipService.ToolTip="Notifications"
                    AutomationProperties.Name="Notifications">
                    <FontIcon
                        Glyph="&#xEA8F;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="16" />
                </Button>
                <Button
                    x:Name="CompactOverlayButton"
                    Style="{StaticResource IconButtonStyle}"
                    Click="CompactOverlayButton_Click"
                    ToolTipService.ToolTip="Mini Mod / Mini Mode"
                    AutomationProperties.Name="Mini Mode">
                    <FontIcon
                        Glyph="&#xE8A7;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Shell: NavigationView + Content Frame                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            CompactPaneLength="72"
            Background="Transparent"
            Loaded="NavView_Loaded"
            SelectionChanged="NavView_SelectionChanged"
            AutomationProperties.Name="Main navigation">

            <!-- Menu Items -->
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Gösterge Paneli"
                    Tag="dashboard"
                    IsSelected="True"
                    AutomationProperties.Name="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE80F;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Tarama"
                    Tag="scan"
                    AutomationProperties.Name="Scan">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE773;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Koruma"
                    Tag="protection"
                    AutomationProperties.Name="Protection">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE72E;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Gizlilik"
                    Tag="privacy"
                    AutomationProperties.Name="Privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE727;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Güvenlik Duvarı"
                    Tag="firewall"
                    AutomationProperties.Name="Firewall">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE785;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Karantina"
                    Tag="quarantine"
                    AutomationProperties.Name="Quarantine">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE7B8;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Raporlar"
                    Tag="reports"
                    AutomationProperties.Name="Reports">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE9D2;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Araçlar"
                    Tag="tools"
                    AutomationProperties.Name="Tools">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE90F;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Parola Yöneticisi"
                    Tag="passwordmanager"
                    AutomationProperties.Name="Password Manager">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE8D7;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="VPN"
                    Tag="vpn"
                    AutomationProperties.Name="VPN">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE839;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Güncelleme"
                    Tag="update"
                    AutomationProperties.Name="Update">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE895;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Footer Items -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="Ayarlar"
                    Tag="settings"
                    AutomationProperties.Name="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE713;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content Frame -->
            <Frame
                x:Name="ContentFrame"
                Padding="0"
                Background="Transparent">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Toast Host (Faz 7) — IToastService'i dinler, sağ-alt overlay -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <controls:ToastHost
            x:Name="ToastHostOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            Canvas.ZIndex="100"
            IsHitTestVisible="True" />
    </Grid>
</Window>
