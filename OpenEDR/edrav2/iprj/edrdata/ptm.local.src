				"powershellEventBaseType": {
			"MLE_POWERSHELL_MALICIOUS": 1000012
		},
		"flsEventBaseType": {
			"MLE_FLS_MALICIOUS_VERDICT": 1000010
		},
		"pswEventBaseType": {
			"MLE_PSW_STEALER": 1000011
		},
		"pswBasket": {
			"pswCredRead": "PSW_CRED_READ",
			"pswReadFiles": "PSW_READ_FILES",
			"pswWriteAfterRead": "PSW_WRITE_AFTER_READ"
		},
		// Credential / browser data paths (imatch is case-insensitive)
		"pswCredPaths": [
			"*\\Google\\Chrome\\User Data*",
			"*\\Microsoft\\Edge\\User Data*",
			"*\\BraveSoftware\\Brave-Browser\\User Data*",
			"*\\Opera Software\\Opera Stable*",
			"*\\Opera Software\\Opera GX Stable*",
			"*\\Discord\\Local Storage*",
			"*\\Discord\\leveldb*",
			"*Electrum\\wallets*",
			"*Bitcoin\\wallets*",
			"*Ethereum\\keystore*",
			"*Cookies*",
			"*Login Data*",
			"*Web Data*",
			"*Local State*"
		],
		// System and browser cache paths excluded from ransomware tripping (FP reduction)
		"ransomSystemExclusions": [
			"*\\Windows\\*",
			"*\\Program Files\\*",
			"*\\Program Files (x86)\\*",
			"*\\ProgramData\\*",
			"*\\AppData\\Local\\Packages\\*",
			"*\\AppData\\Local\\Microsoft\\Edge\\User Data\\EBWebView\\*",
			"*\\AppData\\Local\\Temp\\*",
			"*\\Temp\\*"
		]
		
	},

	"variables": {
		"copyFileKey": [ "@event.process.id", "@event.file.rawHash" ],
		"ransomPathKey": [ "@event.process.id", "@event.file.rawPath" ]
	},

	"patterns": {
		"POWERSHELL_LONG_BASE64": [
			// Case 1: abstractPath available
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.childProcess.imageFile.abstractPath" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.childProcess.imageFile.rawPath" ]
									}
								]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							},
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*-e *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-en *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-enc *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-encodedcommand *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									}
								]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_POWERSHELL_MALICIOUS",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.powershellEventBaseType.MLE_POWERSHELL_MALICIOUS" },
							{ "name": "process", "value": "@event.childProcess" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.childProcess.imageFile.abstractPath" }
						]
					}
				}
			},
			// Case 2: abstractPath missing -> use rawPath
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.childProcess.imageFile.abstractPath" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*powershell*.exe*",
										"args": [ "@event.childProcess.imageFile.rawPath" ]
									}
								]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							},
							{
								"$operation": "or",
								"args": [
									{
										"$operation": "imatch",
										"pattern": "*-e *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-en *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-enc *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									},
									{
										"$operation": "imatch",
										"pattern": "*-encodedcommand *??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????*",
										"args": [ "@event.childProcess.cmdLine" ]
									}
								]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_POWERSHELL_MALICIOUS",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.powershellEventBaseType.MLE_POWERSHELL_MALICIOUS" },
							{ "name": "process", "value": "@event.childProcess" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.childProcess.imageFile.rawPath" }
						]
					}
				}
			}
		], // POWERSHELL_LONG_BASE64



		//
		// Pattern for copy-file READ-WRITE scenario
		//
		"FILE_COPY_READ_WRITE": [

			// Detect full read and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileReadWrite",
						"key": "@var.copyFileKey"
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@event.file"
							},
							{
								"name": "source",
								"value": "@context.file"
							},
							{
								"name": "time",
								"value": "@event.time"
							},
							{
								"name": "tickTime",
								"value": "@event.tickTime"
							},
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileReadWrite",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_READ_WRITE

		//
		// Pattern for copy-file WRITE-READ scenario
		//
		"FILE_COPY_WRITE_READ": [

			// Detect full write and create signature context. No conditions
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"saveContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"group": "@event.process.id",
						"lifetime": 60000,
						"maxCopyCount": 100,
						"data": {
							"file": "@event.file",
							"time": "@event.time",
							"tickTime": "@event.tickTime"
						}
					}
				}
			},

			// Detect full write, check signature context and generate new event
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"loadContext": {
						"basket": "@const.basket.fileWriteRead",
						"key": "@var.copyFileKey",
						"delete": true
					},
					"createEvent": {
						"eventType": "MLE_FILE_COPY",
						"destination": "IN",
						"clone": false,
						"data": [
							{
								"name": "baseType",
								"value": "@const.eventBaseType.MLE_FILE_COPY"
							},
							{
								"name": "process",
								"value": "@event.process"
							},
							{
								"name": "destination",
								"value": "@context.file"
							},
							{
								"name": "source",
								"value": "@event.file"
							},
							{
								"name": "time",
								"value": "@context.time"
							},
							{
								"name": "tickTime",
								"value": "@context.tickTime"
							}
						]
					}
				}
			},

			// Detect process termination and free signature related contexts
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.basket.fileWriteRead",
						"group": "@event.process.id"
					}
				}
			}
		], // FILE_COPY_WRITE_READ

		//
		//
		// PSW Stealer: credential file full-read + outbound network connect.
		// A process that reads credential databases and then connects out
		// is exfiltrating stolen data. No destructive op needed.
		//
		"PSW_CREDENTIAL_ACCESS": [

			// 1a) Full sequential read of a credential/browser data file
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"condition": {
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.pswCredPaths",
								"args": [ "@event.file.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "@const.pswCredPaths",
								"args": [ "@event.file.rawPath" ]
							}
						]
					},
					"saveContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 1b) Memory-mapped section read of a credential/browser data file
			{
				"eventType": "LLE_FILE_MAP_READ",
				"rule": {
					"condition": {
						"$operation": "or",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.pswCredPaths",
								"args": [ "@event.file.abstractPath" ]
							},
							{
								"$operation": "imatch",
								"pattern": "@const.pswCredPaths",
								"args": [ "@event.file.rawPath" ]
							}
						]
					},
					"saveContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id",
						"group": "@event.process.id",
						"lifetime": 600000,
						"data": { "file": "@event.file" }
					}
				}
			},

			// 2a) Outbound network connect - abstractPath available
			{
				"eventType": "LLE_NETWORK_CONNECT_OUT",
				"rule": {
					"condition": {
						"$operation": "imatch",
						"pattern": "?*",
						"args": [ "@event.process.imageFile.abstractPath" ]
					},
					"loadContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id"
					},
					"createEvent": {
						"eventType": "MLE_PSW_STEALER",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},
			// 2b) Outbound network connect - rawPath fallback
			{
				"eventType": "LLE_NETWORK_CONNECT_OUT",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "?*",
						"args": [ "@event.process.imageFile.abstractPath" ]
					},
					"loadContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"key": "@event.process.id"
					},
					"createEvent": {
						"eventType": "MLE_PSW_STEALER",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.pswEventBaseType.MLE_PSW_STEALER" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			},

			// Cleanup on process exit
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.pswBasket.pswCredRead",
						"group": "@event.process.id"
					}
				}
			}
		] // PSW_CREDENTIAL_ACCESS

,
		// Pattern for shadow-copy deletion: vssadmin/wmic/wbadmin wiping
		// volume shadow copies is a near-zero-FP destructive footprint.
		//
		"RANSOM_SHADOW_COPY_DELETE": [
			// Case 1: abstractPath available
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.ransomShadowDeleteCmdLines",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_SHADOW_COPY_DELETE",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomShadowEventBaseType.MLE_RANSOM_SHADOW_COPY_DELETE" },
							{ "name": "process", "value": "@event.childProcess" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.childProcess.imageFile.abstractPath" }
						]
					}
				}
			},
			// Case 2: rawPath fallback
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "imatch",
								"pattern": "@const.ransomShadowDeleteCmdLines",
								"args": [ "@event.childProcess.cmdLine" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.childProcess.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_SHADOW_COPY_DELETE",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomShadowEventBaseType.MLE_RANSOM_SHADOW_COPY_DELETE" },
							{ "name": "process", "value": "@event.childProcess" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.childProcess.imageFile.rawPath" }
						]
					}
				}
			}
		], // RANSOM_SHADOW_COPY_DELETE

		//
		// Crypto-API mass usage: a process issuing >= 2 DISTINCT crypto-API calls
		// Generic distinct-counter (ptm v2 engine, zero hardcoded detection).
		// The `distinctCounter` directive counts distinct non-empty crypto-API names
		// from owlyHook.functionName per process within a 60s window. When >= 2
		// DIFFERENT crypto APIs (across advapi32 / bcrypt / ncrypt / ntdll) are seen
		// it sets @event.CryptoApiThresholdMet. This rule emits MLE_RANSOM_CANDIDATE
		// (crypto_api_mass) for correlation with file-encryption behavior. All
		// detection parameters (fields / scope / threshold / window) live only here.
		//
		"CRYPTO_API_MASS": [
			{
				"eventType": "LLE_DEVICE_IOCTL",
				"rule": {
				"distinctCounter": {
					"basket": "cryptoApiDistinct",
					"key": "@event.process.pid",
					"values": ["@event.owlyHook.functionName"],
					"scope": ["@const.cryptoApiList"],
					"threshold": 2,
					"window": 60000,
					"flag": "@event.CryptoApiThresholdMet"
				},
				"condition": {
					"$operation": "equal",
					"args": [ "@event.CryptoApiThresholdMet", true ]
				},
					"saveContext": {
						"basket": "@const.cryptoBasket.mass",
						"key": "@event.process.id",
						"group": "@event.process.id",
						"lifetime": 60000
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.process.imageFile" },
							{ "name": "subtype", "value": "crypto_api_mass" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			},
			// Cleanup on process exit
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.cryptoBasket.mass",
						"group": "@event.process.id"
					}
				}
			}
		], // CRYPTO_API_MASS

		//
		"RANSOM_COUNTER_INIT": [
			{
				"eventType": "LLE_PROCESS_CREATE",
				"rule": {
					"saveContext": {
						"basket": "@const.ransomBasket.processCounter",
						"key": "@event.childProcess.id",
						"lifetime": 86400000,
						"data": {
							"hitCount": 0
						}
					}
				}
			},
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.ransomBasket.processCounter",
						"group": "@event.process.id"
					}
				}
			}
		], // RANSOM_COUNTER_INIT

		//
		// Pattern for Ransomware destructive overwrite / in-place encryption behavior
		//
		"RANSOM_BEHAVIOR": [

			// Step 1a: File Read -> save context
			{
				"eventType": "LLE_FILE_DATA_READ_FULL",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"saveContext": {
						"basket": "@const.ransomBasket.readWrite",
						"key": "@event.file.path",
						"lifetime": 120000,
						"data": {
							"file": "@event.file"
						}
					}
				}
			},

			// Step 1b: Memory-mapped file read (mmap) -> save context
			{
				"eventType": "LLE_FILE_MAP_READ",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"saveContext": {
						"basket": "@const.ransomBasket.readWrite",
						"key": "@event.file.path",
						"lifetime": 120000,
						"data": {
							"file": "@event.file"
						}
					}
				}
			},

			// Step 2a: File Create -> trigger Candidate
			{
				"eventType": "LLE_FILE_CREATE",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2b: File Write Full -> trigger Candidate
			{
				"eventType": "LLE_FILE_DATA_WRITE_FULL",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2c: Memory-mapped write (mmap flush) -> trigger Candidate
			{
				"eventType": "LLE_FILE_MAP_WRITE",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2d: File Data Change (LLE_FILE_DATA_CHANGE) -> trigger Candidate
			{
				"eventType": "LLE_FILE_DATA_CHANGE",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2e: Raw RF10* Events (RF10.7) -> trigger Candidate
			{
				"eventType": "RF10*",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2f: File Rename -> trigger Candidate
			{
				"eventType": "LLE_FILE_RENAME",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2g: File Delete -> trigger Candidate
			{
				"eventType": "LLE_FILE_DELETE",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 2h: Raw RF4* Events (RF4.8) -> trigger Candidate
			{
				"eventType": "RF4*",
				"rule": {
					"condition": {
						"$operation": "!imatch",
						"pattern": "@const.ransomSystemExclusions",
						"args": [ "@event.file.path" ]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_CANDIDATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.file" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.path" }
						]
					}
				}
			},

			// Step 3: Forward candidate to evaluation
			{
				"eventType": "MLE_RANSOM_CANDIDATE",
				"rule": {
					"createEvent": {
						"eventType": "MLE_RANSOM_EVALUATE",
						"destination": "IN",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.destination" },
							{ "name": "source", "value": "@event.source" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" }
						]
					}
				}
			},

			// Step 4a: Fast Lane evaluation (User Profile files -> 1 hit detection)
			{
			"eventType": "MLE_RANSOM_EVALUATE",
			"rule": {
				"loadContext": {
					"basket": "@const.cryptoBasket.mass",
					"key": "@event.process.id"
				},
				"condition": {
					"$operation": "and",
					"args": [
						{
							"$operation": "!imatch",
							"pattern": "@const.ransomSystemExclusions",
							"args": [ "@event.destination.path" ]
						},
						{
							"$operation": "imatch",
							"pattern": "*\\users\\*",
							"args": [ "@event.destination.path" ]
						},
							{
								"$operation": "!imatch",
								"pattern": "*\\appdata\\*",
								"args": [ "@event.destination.path" ]
							},
							{
								"$operation": "imatch",
								"pattern": "@const.ransomFileExtensions",
								"args": [ "@event.destination.path" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_BEHAVIOR",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.destination" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			},

			// Step 4b: General evaluation for files outside AppData.
			// Corroborated by crypto_api_mass (loadContext) so it is definitive, and
			// scoped to targeted file extensions to avoid FP on extensionless / temp files.
			{
				"eventType": "MLE_RANSOM_EVALUATE",
				"rule": {
					"loadContext": {
						"basket": "@const.cryptoBasket.mass",
						"key": "@event.process.id"
					},
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "!imatch",
								"pattern": "@const.ransomSystemExclusions",
								"args": [ "@event.destination.path" ]
							},
							{
								"$operation": "!imatch",
								"pattern": "*\\appdata\\*",
								"args": [ "@event.destination.path" ]
							},
							{
								"$operation": "imatch",
								"pattern": "@const.ransomFileExtensions",
								"args": [ "@event.destination.path" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_RANSOM_BEHAVIOR",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.ransomBehaviorEventBaseType.MLE_RANSOM_BEHAVIOR" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "destination", "value": "@event.destination" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			},

			// Step 5: Cleanup context when process exits
			{
				"eventType": "LLE_PROCESS_DELETE",
				"rule": {
					"deleteContext": {
						"basket": "@const.ransomBasket.readWrite",
						"group": "@event.process.id"
					}
				}
			}
		], // RANSOM_BEHAVIOR

		//
		// Pattern for cloud FLS malicious verdict
		//
		"FLS_MALICIOUS_VERDICT": [
			// Case 1: file.verdict is 2 (MALWARE), abstractPath is available
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.file.verdict", 2 ]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.abstractPath" }
						]
					}
				}
			},
			// Case 2: file.verdict is 2 (MALWARE), abstractPath is missing -> use rawPath
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.file.verdict", 2 ]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.file.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.file.rawPath" }
						]
					}
				}
			},
			// Case 3: process.imageFile.verdict is 2 (MALWARE), abstractPath is available
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.process.imageFile.verdict", 2 ]
							},
							{
								"$operation": "imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.abstractPath" }
						]
					}
				}
			},
			// Case 4: process.imageFile.verdict is 2 (MALWARE), abstractPath is missing -> use rawPath
			{
				"eventType": "*",
				"rule": {
					"condition": {
						"$operation": "and",
						"args": [
							{
								"$operation": "equal",
								"args": [ "@event.process.imageFile.verdict", 2 ]
							},
							{
								"$operation": "!imatch",
								"pattern": "?*",
								"args": [ "@event.process.imageFile.abstractPath" ]
							}
						]
					},
					"createEvent": {
						"eventType": "MLE_FLS_MALICIOUS_VERDICT",
						"destination": "OUT",
						"clone": false,
						"data": [
							{ "name": "baseType", "value": "@const.flsEventBaseType.MLE_FLS_MALICIOUS_VERDICT" },
							{ "name": "process", "value": "@event.process" },
							{ "name": "processes", "value": "@event.processes" },
							{ "name": "file", "value": "@event.file" },
							{ "name": "network", "value": "@event.network" },
							{ "name": "time", "value": "@event.time" },
							{ "name": "tickTime", "value": "@event.tickTime" },
							{ "name": "quarantineTarget", "value": "@event.process.imageFile.rawPath" }
						]
					}
				}
			}
		] // FLS_MALICIOUS_VERDICT
	}
}

